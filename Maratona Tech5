.toast.error{border-left:3px solid var(--accent-danger)}
.toast.error .toast-icon{background:rgba(255,51,102,0.15);color:var(--accent-danger)}
.toast.warning{border-left:3px solid var(--accent-warning)}
.toast.warning .toast-icon{background:rgba(255,184,0,0.15);color:var(--accent-warning)}
.toast.info{border-left:3px solid var(--accent-info)}
.toast.info .toast-icon{background:rgba(0,212,255,0.15);color:var(--accent-info)}
.toast.achievement{border-left:3px solid var(--accent-warning);background:linear-gradient(135deg,rgba(255,184,0,0.1),var(--bg-card))}
.toast.achievement .toast-icon{background:rgba(255,184,0,0.2);color:var(--accent-warning);animation:bounce 1s ease}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.toast-content{flex:1}
.toast-title{font-family:var(--font-hacker);font-size:0.82rem;font-weight:600;color:var(--text-primary);margin-bottom:0.1rem}
.toast-message{font-size:0.78rem;color:var(--text-secondary)}
@media(max-width:768px){
  .header{padding:0.75rem 1rem}
  .logo-title{font-size:0.95rem}
  .logo-subtitle{font-size:0.6rem}
  .status-indicator{display:none}
  .main-content{padding:1rem}
  .tabs-wrapper{padding:0 1rem}
  .tabs{padding:3px}
  .tab-btn{padding:0.5rem 0.85rem;font-size:0.78rem}
  .tab-btn .tab-label{display:none}
  .tab-btn .tab-icon{font-size:1.1rem}
