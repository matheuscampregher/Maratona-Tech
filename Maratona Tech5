<script>
/* MATRIX RAIN */
const Matrix={canvas:null,ctx:null,columns:[],fontSize:14,running:true,init(){this.canvas=document.getElementById('matrix-canvas');this.ctx=this.canvas.getContext('2d');this.resize();this.start();window.addEventListener('resize',()=>this.resize())},resize(){this.canvas.width=window.innerWidth;this.canvas.height=window.innerHeight;this.columns=[];const cols=Math.floor(this.canvas.width/this.fontSize);for(let i=0;i<cols;i++)this.columns[i]=Math.random()*-100},start(){const chars='01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲﾝ';const draw=()=>{if(!this.running)return;this.ctx.fillStyle='rgba(5,7,13,0.05)';this.ctx.fillRect(0,0,this.canvas.width,this.canvas.height);this.ctx.fillStyle='#00ff41';this.ctx.font=this.fontSize+'px monospace';for(let i=0;i<this.columns.length;i++){const char=chars[Math.floor(Math.random()*chars.length)];const x=i*this.fontSize;const y=this.columns[i]*this.fontSize;this.ctx.fillText(char,x,y);if(y>this.canvas.height&&Math.random()>0.975)this.columns[i]=0;this.columns[i]++}requestAnimationFrame(draw)};draw()}};

/* STORAGE */
const Storage={keys:{theme:'phishing_agv_theme',stats:'phishing_agv_stats',achievements:'phishing_agv_achievements'},get(key,defaultValue=null){try{const value=localStorage.getItem(key);return value?JSON.parse(value):defaultValue}catch(e){return defaultValue}},set(key,value){try{localStorage.setItem(key,JSON.stringify(value))}catch(e){console.warn('Storage error:',e)}},getDefaultStats(){return{analyses:0,threats:0,quizzes:0,quizCorrect:0,quizTotal:0,avgScore:0,last7Days:[0,0,0,0,0,0,0],threatTypes:{urgency:0,links:0,sensitive:0,structure:0}}},recordAnalysis(isThreat,threatCategories=[]){const stats=this.get(this.keys.stats,this.getDefaultStats());stats.analyses=(stats.analyses||0)+1;if(isThreat)stats.threats=(stats.threats||0)+1;const today=new Date().getDay();if(!Array.isArray(stats.last7Days))stats.last7Days=[0,0,0,0,0,0,0];stats.last7Days[today]=(stats.last7Days[today]||0)+1;if(!stats.threatTypes)stats.threatTypes={urgency:0,links:0,sensitive:0,structure:0};threatCategories.forEach(cat=>{if(stats.threatTypes[cat]!==undefined)stats.threatTypes[cat]++});this.set(this.keys.stats,stats);return stats},recordQuiz(correct,total){const stats=this.get(this.keys.stats,this.getDefaultStats());stats.quizzes=(stats.quizzes||0)+1;stats.quizCorrect=(stats.quizCorrect||0)+correct;stats.quizTotal=(stats.quizTotal||0)+total;stats.avgScore=Math.round((stats.quizCorrect/stats.quizTotal)*100);this.set(this.keys.stats,stats);return stats}};

/* TOAST */
const Toast={show(type,title,message,duration=4000){const container=document.getElementById('toastContainer');const toast=document.createElement('div');toast.className=`toast ${type}`;const icons={success:'✓',error:'✕',warning:'⚠',info:'ℹ',achievement:'🏆'};toast.innerHTML=`<div class="toast-icon">${icons[type]||'ℹ'}</div><div class="toast-content"><div class="toast-title">${title}</div><div class="toast-message">${message}</div></div>`;container.appendChild(toast);setTimeout(()=>toast.remove(),duration)}};

/* ACHIEVEMENTS */
const Achievements={definitions:[{id:'first_quiz',name:'Primeiro Passo',desc:'Concluiu seu primeiro quiz',icon:'🎯',condition:s=>s.quizzes>=1},{id:'analyst_10',name:'Analista Júnior',desc:'Analisou 10 e-mails',icon:'🔍',condition:s=>s.analyses>=10},{id:'analyst_50',name:'Analista Sênior',desc:'Analisou 50 e-mails',icon:'🕵️',condition:s=>s.analyses>=50},{id:'detective',name:'Detetive Digital',desc:'Detectou 25 golpes',icon:'🔦',condition:s=>s.threats>=25},{id:'hunter',name:'Caçador de Golpes',desc:'Detectou 100 golpes',icon:'🏹',condition:s=>s.threats>=100},{id:'expert',name:'Especialista',desc:'Acertou 80%+ no quiz',icon:'🏆',condition:s=>s.avgScore>=80&&s.quizzes>=3},{id:'master',name:'Mestre em Segurança',desc:'Concluiu 10 quizzes',icon:'👑',condition:s=>s.quizzes>=10},{id:'perfect',name:'Perfeição',desc:'Quiz com 100% de acerto',icon:'⭐',condition:s=>s._lastPerfect===true}],check(stats){const unlocked=Storage.get(Storage.keys.achievements,[]);let newUnlocks=[];this.definitions.forEach(def=>{if(!unlocked.includes(def.id)&&def.condition(stats)){unlocked.push(def.id);newUnlocks.push(def)}});if(newUnlocks.length>0){Storage.set(Storage.keys.achievements,unlocked);newUnlocks.forEach(ach=>{Toast.show('achievement','Conquista Desbloqueada!',`${ach.icon} ${ach.name}`);if(typeof confetti!=='undefined')confetti({particleCount:80,spread:70,origin:{y:0.6}})})}return unlocked},render(){const grid=document.getElementById('achievementsGrid');if(!grid)return;const unlocked=Storage.get(Storage.keys.achievements,[]);grid.innerHTML=this.definitions.map(def=>{const isUnlocked=unlocked.includes(def.id);return`<div class="achievement-card ${isUnlocked?'unlocked':'locked'}"><span class="achievement-icon">${def.icon}</span><div class="achievement-name">${def.name}</div><div class="achievement-desc">${def.desc}</div></div>`}).join('')}};

/* THEME */
const Theme={init(){const saved=Storage.get(Storage.keys.theme,'dark');this.apply(saved);document.querySelectorAll('.theme-btn').forEach(btn=>{btn.addEventListener('click',()=>this.apply(btn.dataset.theme))})},apply(theme){document.documentElement.setAttribute('data-theme',theme);Storage.set(Storage.keys.theme,theme);document.querySelectorAll('.theme-btn').forEach(btn=>{btn.classList.toggle('active',btn.dataset.theme===theme)});if(Dashboard.chartsInitialized)Dashboard.updateCharts()}};

/* TAB SWITCHING - CORRIGIDO */
function switchTab(tabName){
