.achievement-icon{font-size:2.5rem;margin-bottom:0.5rem;display:block}
.achievement-card.unlocked .achievement-icon{filter:drop-shadow(0 0 10px rgba(255,184,0,0.5))}
.achievement-name{font-family:var(--font-hacker);font-size:0.85rem;font-weight:600;color:var(--text-primary);margin-bottom:0.25rem}
.achievement-desc{font-size:0.75rem;color:var(--text-muted)}
.achievement-card.unlocked::before{content:'✓';position:absolute;top:8px;right:8px;background:var(--accent-success);color:white;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700}
.toast-container{position:fixed;top:90px;right:20px;z-index:9998;display:flex;flex-direction:column;gap:0.65rem;max-width:380px}
.toast{background:var(--bg-card);backdrop-filter:blur(20px);border:1px solid var(--border-color);border-radius:var(--radius-md);padding:0.85rem 1.15rem;display:flex;align-items:center;gap:0.75rem;box-shadow:var(--shadow-lg);animation:slideInRight 0.4s ease,fadeOut 0.4s ease 3.6s forwards;min-width:280px}
