.disclaimer{background:linear-gradient(135deg,rgba(255,184,0,0.08),rgba(255,184,0,0.03));border:1px solid rgba(255,184,0,0.25);border-radius:var(--radius-md);padding:1.15rem;margin-top:1.5rem;display:flex;align-items:flex-start;gap:0.85rem;font-size:0.85rem;color:var(--text-secondary)}
