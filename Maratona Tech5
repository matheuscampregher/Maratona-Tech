.quiz-answers{padding:1.5rem;display:flex;gap:1rem;flex-wrap:wrap}
.quiz-answer-btn{flex:1;min-width:150px;padding:1rem;background:var(--bg-tertiary);border:2px solid var(--border-color);border-radius:var(--radius-md);color:var(--text-primary);font-family:var(--font-sans);font-size:0.95rem;font-weight:600;cursor:pointer;transition:all var(--transition-base);display:flex;align-items:center;justify-content:center;gap:0.5rem}
