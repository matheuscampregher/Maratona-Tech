    document.getElementById('btnQuizRestart').addEventListener('click',()=>this.restart());
    document.getElementById('btnQuizStudy').addEventListener('click',()=>switchTab('learn'));
    STATS=STATS||await DB.get(KEYS.stats,false,defaultStats());
    STATS.quizzes=(STATS.quizzes||0)+1;
    STATS.quizCorrect=(STATS.quizCorrect||0)+this.score;
    STATS.quizTotal=(STATS.quizTotal||0)+total;
    STATS.avgScore=Math.round((STATS.quizCorrect/STATS.quizTotal)*100);
    STATS.lastPerfect=this.score===total;
    STATS.lastPct=pct;
    await DB.set(KEYS.stats,STATS,false);
    Dashboard.updateStats();
    await Achievements.check(STATS);
    await Dashboard.updateLeaderboardEntry();
    if(pct>=80&&typeof confetti!=='undefined')confetti({particleCount:150,spread:100,origin:{y:.5}});
    Toast.show('success','Quiz concluído!',`Você acertou ${this.score}/${total}`);
  },
  restart(){document.getElementById('quizResult').style.display='none';document.getElementById('quizStart').style.display='block'},
  esc(str){const d=document.createElement('div');d.textContent=str;return d.innerHTML}
};

