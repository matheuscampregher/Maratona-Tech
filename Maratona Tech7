      {pattern:/https?:\/\/[^\s]*\.(xyz|top|club|click|tk|ml|cf|gq|pw|icu|buzz)/gi,name:"Domínio suspeito",desc:"Extensão pouco usual, comum em golpes.",severity:"medium",score:12}
    ],
    structure:[
      {pattern:/^(prezado\s+cliente|prezado\s+usu[áa]rio|caro\s+cliente)/gim,name:"Saudação genérica",desc:"'Prezado cliente' em vez do seu nome — envio em massa.",severity:"medium",score:8},
      {pattern:/[A-ZÁÉÍÓÚÂÊÔÃÕÇ]{10,}/g,name:"CAIXA ALTA excessiva",desc:"Trechos longos em maiúsculas.",severity:"medium",score:6},
      {pattern:/(gr[aá]tis|pr[eê]mio|ganh(ou|e|o)|parab[eé]ns|sorteado)/gi,name:"Promessa de ganho",desc:"Promessa de prêmio fácil — isca clássica.",severity:"medium",score:12},
      {pattern:/(anexo|attachment).*\.(exe|scr|zip|bat|cmd|vbs|js)/gi,name:"Anexo suspeito",desc:"Extensão executável — risco de malware.",severity:"high",score:20}
    ],
    sms:[
      {pattern:/troquei\s+de\s+n[uú]mero/gi,name:"'Troquei de número'",desc:"Tática clássica de golpe do falso familiar.",severity:"high",score:16},
      {pattern:/fa[cç]a?\s+um?\s+pix/gi,name:"Pedido de Pix",desc:"Pedido direto de transferência Pix.",severity:"high",score:16},
      {pattern:/n[aã]o\s+posso\s+falar/gi,name:"Evita ligação/confirmação",desc:"Impede verificação por voz — sinal de golpe.",severity:"medium",score:10},
      {pattern:/responda\s+sim/gi,name:"'Responda SIM'",desc:"Confirma número ativo para o golpista.",severity:"low",score:5}
    ]
  },
  analyze(text,channel){
    const signals=[];let totalScore=0;
    const categories={urgency:0,links:0,sensitive:0,structure:0,sms:0};
    const cats=channel==='sms'?['urgency','sensitive','links','sms']:['urgency','sensitive','links','structure'];
    for(const cat of cats){
      for(const rule of (this.rules[cat]||[])){
        const matches=text.match(rule.pattern);
        if(matches){const score=rule.score*Math.min(matches.length,3);totalScore+=score;categories[cat]+=score;
          signals.push({name:rule.name,desc:rule.desc,severity:rule.severity,count:matches.length,score,category:cat,icon:rule.severity==='high'?'🚨':rule.severity==='medium'?'⚠️':'ℹ️'})}
      }
    }
    totalScore=Math.min(totalScore,100);
    let verdict,verdictClass,verdictDesc;
    if(totalScore>=70){verdict="ALTO RISCO";verdictClass="danger";verdictDesc="Múltiplos indicadores de golpe. Não interaja com esta mensagem."}
    else if(totalScore>=40){verdict="SUSPEITO";verdictClass="suspicious";verdictDesc="Elementos suspeitos presentes. Prossiga com cautela."}
    else if(totalScore>=20){verdict="ATENÇÃO";verdictClass="suspicious";verdictDesc="Alguns elementos merecem atenção antes de agir."}
    else{verdict="PROVÁVEL LEGÍTIMO";verdictClass="safe";verdictDesc="Nenhum indicador forte de golpe detectado."}
    return{score:totalScore,signals,categories,verdict,verdictClass,verdictDesc};
  },
  recommendations(signals){
    const recs=[];const names=new Set(signals.map(s=>s.name));
    if(signals.some(s=>s.severity==='high'))recs.push({icon:"🚫",text:"Não clique em links nem forneça dados pessoais."});
    if([...names].some(n=>/domínio|URL|Link|Encurtador/.test(n)))recs.push({icon:"🌐",text:"Digite o endereço oficial direto no navegador, nunca clique em links recebidos."});
    if([...names].some(n=>/senha|CPF|cartão|Pix/.test(n)))recs.push({icon:"🔐",text:"Nenhuma empresa legítima pede senha, CPF ou código completo por mensagem."});
    if([...names].some(n=>/urgência|prazo|bloqueio|Pix/.test(n)))recs.push({icon:"🧘",text:"Não aja por impulso — confirme por um canal oficial antes de qualquer transferência."});
    if([...names].some(n=>/número/.test(n)))recs.push({icon:"☎️",text:"Ligue para o número que você já conhece, nunca o que enviou a mensagem."});
    recs.push({icon:"📞",text:"Em dúvida, contate a empresa pelos canais oficiais (site ou telefone)."});
    recs.push({icon:"🛡️",text:"Se já clicou em algo suspeito, troque suas senhas e ative o 2FA."});
    return recs;
  }
};

