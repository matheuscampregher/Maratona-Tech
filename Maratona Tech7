/* ---------- DASHBOARD ---------- */
const Dashboard={
  chartsInitialized:false,charts:{},
  async init(){await this.updateStats();await Achievements.render();this.initCharts();await this.renderLeaderboard()},
  async updateStats(){
    STATS=await DB.get(KEYS.stats,false,defaultStats());
    this.animateNumber('stat-analyses',STATS.analyses||0);
    this.animateNumber('stat-threats',STATS.threats||0);
    this.animateNumber('stat-quizzes',STATS.quizzes||0);
    document.getElementById('stat-avg-score').textContent=(STATS.avgScore||0)+'%';
  },
  animateNumber(id,target){
    const el=document.getElementById(id);if(!el)return;
    const current=parseInt(el.textContent)||0;if(current===target)return;
    const steps=24;const inc=(target-current)/steps;let v=current,i=0;
    const iv=setInterval(()=>{i++;v+=inc;if(i>=steps){v=target;clearInterval(iv)}el.textContent=Math.round(v)},20);
  },
  initCharts(){
    if(typeof Chart==='undefined')return;
    const cs=getComputedStyle(document.documentElement);
    Chart.defaults.color=cs.getPropertyValue('--text-dim').trim();
    Chart.defaults.borderColor=cs.getPropertyValue('--border').trim();
    Chart.defaults.font.family="'Inter',sans-serif";
    const ctx1=document.getElementById('chart-analyses');
    if(ctx1){
      const days=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];const today=new Date().getDay();
      const last7=STATS.last7Days||[0,0,0,0,0,0,0];const labels=[],data=[];
      for(let i=6;i>=0;i--){const idx=(today-i+7)%7;labels.push(days[idx]);data.push(last7[idx]||0)}
      this.charts.analyses=new Chart(ctx1,{type:'line',data:{labels,datasets:[{label:'Análises',data,borderColor:cs.getPropertyValue('--accent').trim(),backgroundColor:cs.getPropertyValue('--accent-soft').trim(),tension:.4,fill:true,borderWidth:2,pointRadius:3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{stepSize:1}},x:{grid:{display:false}}}}});
    }
    const ctx2=document.getElementById('chart-threats');
    if(ctx2){
      const tt=STATS.threatTypes||{urgency:0,links:0,sensitive:0,structure:0,sms:0};
      this.charts.threats=new Chart(ctx2,{type:'doughnut',data:{labels:['Urgência','Links','Dados','Estrutura','SMS'],datasets:[{data:[tt.urgency||0,tt.links||0,tt.sensitive||0,tt.structure||0,tt.sms||0],backgroundColor:['#e8583d','#e8a93d','#4c6fff','#7b8cff','#1fae7a'],borderColor:cs.getPropertyValue('--card-solid').trim(),borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,cutout:'60%',plugins:{legend:{position:'bottom',labels:{padding:12,font:{size:10}}}}}});
    }
    this.chartsInitialized=true;
  },
  updateCharts(){
    if(!this.chartsInitialized||!STATS)return;
    if(this.charts.analyses){const today=new Date().getDay();const last7=STATS.last7Days||[0,0,0,0,0,0,0];const data=[];for(let i=6;i>=0;i--){data.push(last7[(today-i+7)%7]||0)}this.charts.analyses.data.datasets[0].data=data;this.charts.analyses.update()}
    if(this.charts.threats){const tt=STATS.threatTypes||{};this.charts.threats.data.datasets[0].data=[tt.urgency||0,tt.links||0,tt.sensitive||0,tt.structure||0,tt.sms||0];this.charts.threats.update()}
  },
  async updateLeaderboardEntry(){
    if(!PROFILE||!PROFILE.id)return;
    const entry={name:PROFILE.name,turma:PROFILE.turma,avgScore:STATS.avgScore||0,quizzes:STATS.quizzes||0,updated:Date.now()};
    await DB.set('leaderboard:'+PROFILE.id,entry,true);
  },
  async renderLeaderboard(){
    const wrap=document.getElementById('leaderboardList');
    if(!wrap)return;
    wrap.innerHTML='<p class="text-faint" style="font-size:.85rem">Carregando...</p>';
    try{
      const keys=await DB.list('leaderboard:',true);
      if(!keys||!keys.length){wrap.innerHTML='<p class="text-faint" style="font-size:.85rem">Ainda não há dados de outros alunos neste ranking.</p>';return}
      const entries=[];
      for(const k of keys.slice(0,50)){const e=await DB.get(k,true,null);if(e)entries.push(e)}
      entries.sort((a,b)=>(b.avgScore||0)-(a.avgScore||0));
      wrap.innerHTML=entries.slice(0,10).map((e,i)=>`<div class="leaderboard-row"><span class="leaderboard-rank">${i+1}</span><span class="leaderboard-name">${e.name||'Aluno(a)'} <span class="leaderboard-turma">${e.turma||''}</span></span><span class="leaderboard-score">${e.avgScore||0}%</span></div>`).join('');
    }catch(err){wrap.innerHTML='<p class="text-faint" style="font-size:.85rem">Não foi possível carregar o ranking agora.</p>'}
  }
};

