<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Phishing AGV - Plataforma educativa de conscientização contra phishing">
<title>Phishing AGV // Plataforma de Conscientização Digital</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#0b1120; --bg-elev:#121a2e; --bg-elev-2:#182238;
  --card:rgba(24,34,56,0.62); --card-solid:#161f34;
  --border:rgba(150,163,196,0.16); --border-strong:rgba(150,163,196,0.32);
  --text:#e7eaf2; --text-dim:#9aa5bc; --text-faint:#667089; --text-on-accent:#fff;
  --accent:#4c6fff; --accent-2:#7b8cff; --accent-soft:rgba(76,111,255,0.14);
  --safe:#1fae7a; --safe-soft:rgba(31,174,122,0.14);
  --warn:#e8a93d; --warn-soft:rgba(232,169,61,0.14);
  --danger:#e8583d; --danger-soft:rgba(232,88,61,0.14);
  --shadow-sm:0 2px 10px rgba(3,6,16,0.25);
  --shadow-md:0 10px 30px rgba(3,6,16,0.4);
  --shadow-lg:0 20px 50px rgba(3,6,16,0.5);
  --radius-sm:8px; --radius-md:14px; --radius-lg:20px;
  --font-ui:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-serif:'Source Serif 4',Georgia,serif;
  --font-mono:'JetBrains Mono','Fira Code',Consolas,monospace;
  --ease:cubic-bezier(0.4,0,0.2,1);
}
[data-theme="light"]{
  --bg:#f6f7fb; --bg-elev:#ffffff; --bg-elev-2:#eef1f8;
  --card:rgba(255,255,255,0.92); --card-solid:#ffffff;
  --border:rgba(20,30,60,0.10); --border-strong:rgba(20,30,60,0.22);
  --text:#12182b; --text-dim:#525e7a; --text-faint:#8189a0; --text-on-accent:#fff;
  --accent:#3853d6; --accent-2:#5468e0; --accent-soft:rgba(56,83,214,0.08);
  --safe:#128a5d; --safe-soft:rgba(18,138,93,0.10);
  --warn:#b9791f; --warn-soft:rgba(185,121,31,0.10);
  --danger:#c8432b; --danger-soft:rgba(200,67,43,0.10);
  --shadow-sm:0 2px 10px rgba(20,30,60,0.06);
  --shadow-md:0 10px 30px rgba(20,30,60,0.08);
  --shadow-lg:0 20px 50px rgba(20,30,60,0.12);
}
html{scroll-behavior:smooth}
body{font-family:var(--font-ui);background:var(--bg);color:var(--text);min-height:100vh;line-height:1.6;overflow-x:hidden}
#matrix-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:0;transition:opacity .4s}
body.hacker-mode #matrix-canvas{opacity:.12}
a{color:var(--accent)}
:focus-visible{outline:2.5px solid var(--accent);outline-offset:2px;border-radius:4px}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:var(--bg-elev)}
::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:5px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}

/* loading */
.loading-screen{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;transition:opacity .5s,visibility .5s}
.loading-screen.hidden{opacity:0;visibility:hidden}
.loading-mark{width:64px;height:64px;border-radius:16px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;font-size:1.8rem;margin-bottom:1.4rem;box-shadow:var(--shadow-lg)}
.loading-spinner{width:34px;height:34px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.9s linear infinite;margin-bottom:.9rem}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{font-family:var(--font-mono);color:var(--text-dim);font-size:.78rem;letter-spacing:2px}

/* onboarding modal */
.modal-overlay{position:fixed;inset:0;background:rgba(5,8,16,0.6);backdrop-filter:blur(4px);z-index:9000;display:flex;align-items:center;justify-content:center;padding:1.25rem}
.modal-overlay[hidden]{display:none}
.modal-box{background:var(--card-solid);border:1px solid var(--border);border-radius:var(--radius-lg);padding:2rem;max-width:440px;width:100%;box-shadow:var(--shadow-lg)}
.modal-box h2{font-size:1.3rem;margin-bottom:.4rem}
.modal-box p{color:var(--text-dim);font-size:.9rem;margin-bottom:1.3rem}
.field-group{margin-bottom:1rem}
.field-group label{display:block;font-size:.8rem;font-weight:600;color:var(--text-dim);margin-bottom:.4rem}
.field-group input{width:100%;padding:.7rem .9rem;background:var(--bg-elev-2);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:var(--font-ui);font-size:.92rem}
.field-group input:focus{border-color:var(--accent)}
.modal-actions{display:flex;gap:.6rem;margin-top:1.4rem}

/* header */
.header{position:sticky;top:0;z-index:100;background:var(--card);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:0.85rem 1.75rem}
.header-content{max-width:1360px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:1.25rem}
.logo{display:flex;align-items:center;gap:.75rem;cursor:pointer;background:none;border:none}
.logo-icon{width:42px;height:42px;border-radius:11px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;flex-shrink:0}
.logo-text-group{display:flex;flex-direction:column;text-align:left}
.logo-title{font-size:1.02rem;font-weight:800;letter-spacing:.2px;color:var(--text)}
.logo-subtitle{font-size:.68rem;color:var(--text-faint);letter-spacing:.6px;text-transform:uppercase}
.header-right{display:flex;align-items:center;gap:.85rem}
.student-chip{display:flex;align-items:center;gap:.5rem;font-size:.78rem;color:var(--text-dim);background:var(--bg-elev-2);border:1px solid var(--border);padding:.4rem .75rem;border-radius:20px}
.student-chip button{background:none;border:none;color:var(--text-faint);cursor:pointer;font-size:.72rem;text-decoration:underline}
.toggle-group{display:flex;background:var(--bg-elev-2);border:1px solid var(--border);border-radius:10px;padding:3px;gap:2px}
.toggle-btn{background:transparent;border:none;color:var(--text-faint);padding:6px 9px;border-radius:7px;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center}
.toggle-btn.active{background:var(--accent);color:#fff}
.hacker-switch{display:flex;align-items:center;gap:.4rem;font-size:.7rem;color:var(--text-faint);cursor:pointer}
.hacker-switch input{accent-color:var(--accent)}

/* tabs */
.tabs-wrapper{max-width:1360px;margin:1.25rem auto 0;padding:0 1.75rem}
.tabs{display:flex;gap:3px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-md);padding:5px;overflow-x:auto;box-shadow:var(--shadow-sm)}
.tab-btn{flex-shrink:0;background:transparent;border:none;color:var(--text-dim);font-size:.84rem;font-weight:600;padding:.6rem 1rem;cursor:pointer;border-radius:9px;display:flex;align-items:center;gap:.4rem;white-space:nowrap}
.tab-btn:hover{color:var(--text);background:var(--accent-soft)}
.tab-btn.active{background:var(--accent);color:#fff}

.main-content{max-width:1360px;margin:0 auto;padding:1.75rem;position:relative;z-index:1}
.tab-content{display:none;animation:fadeIn .35s ease}
.tab-content.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.card{background:var(--card);backdrop-filter:blur(10px);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.6rem;transition:border-color .2s,box-shadow .2s}
.card:hover{border-color:var(--border-strong)}
.section{margin-bottom:1.75rem}
.section-title{font-size:1.05rem;font-weight:700;margin-bottom:1.1rem;display:flex;align-items:center;gap:.55rem}
.section-title .title-icon{width:30px;height:30px;border-radius:9px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
.section-lede{font-family:var(--font-serif);font-size:1.02rem;line-height:1.75;color:var(--text)}
.section-lede p{margin-bottom:.9rem}
.highlight{color:var(--accent);font-weight:600}
.highlight-safe{color:var(--safe);font-weight:600}
.highlight-warn{color:var(--warn);font-weight:600}
.highlight-danger{color:var(--danger);font-weight:600}
.text-dim{color:var(--text-dim)}
.text-faint{color:var(--text-faint)}

.analogy-box{background:var(--accent-soft);border:1px solid var(--border-strong);border-radius:var(--radius-md);padding:1rem 1.2rem;margin-top:1rem;display:flex;gap:.8rem;align-items:center}
.analogy-box .icon{font-size:1.5rem;flex-shrink:0}
.analogy-box p{margin:0;font-style:italic;color:var(--text-dim);font-size:.88rem}

/* timeline */
.timeline-horizontal{display:flex;gap:0;margin-top:1.4rem;overflow-x:auto;padding:.6rem 0}
.timeline-step{flex:1;min-width:110px;position:relative;padding:0 .5rem;display:flex;flex-direction:column;align-items:center;text-align:center}
.timeline-step::after{content:'';position:absolute;top:20px;right:-20%;width:40%;height:1.5px;background:var(--border-strong)}
.timeline-step:last-child::after{display:none}
.step-icon{width:40px;height:40px;border-radius:11px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.05rem;margin-bottom:.5rem;z-index:1}
.timeline-step:nth-child(even) .step-icon{background:var(--danger)}
.step-title{font-size:.78rem;font-weight:700;margin-bottom:.15rem}
.step-desc{font-size:.7rem;color:var(--text-faint)}

/* signs grid */
.signs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:.9rem;margin-top:1rem}
.sign-item{background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-md);padding:1rem;display:flex;gap:.75rem}
.sign-icon{width:36px;height:36px;border-radius:9px;background:var(--warn-soft);display:flex;align-items:center;justify-content:center;font-size:1.05rem;flex-shrink:0}
.sign-item h4{font-size:.86rem;color:var(--warn);margin-bottom:.2rem;font-weight:700}
.sign-item p{font-size:.8rem;color:var(--text-dim);margin:0}

.checklist{list-style:none;margin-top:1rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:.6rem}
.checklist li{padding:.8rem .95rem;background:var(--safe-soft);border:1px solid var(--border);border-radius:var(--radius-md);display:flex;gap:.7rem;color:var(--text-dim);font-size:.86rem}
.checklist li .check-icon{color:var(--safe);flex-shrink:0}
.checklist li strong{color:var(--text)}

/* comparison */
.comparison-container{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem;margin-top:1rem}
@media(max-width:768px){.comparison-container{grid-template-columns:1fr}}
.email-example{border-radius:var(--radius-md);overflow:hidden;font-size:.85rem;box-shadow:var(--shadow-sm)}
.email-example.safe{border:1px solid var(--safe)}
.email-example.phishing{border:1px solid var(--danger)}
.email-header{padding:.75rem 1.05rem;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px}
.safe .email-header{background:var(--safe-soft);color:var(--safe)}
.phishing .email-header{background:var(--danger-soft);color:var(--danger)}
.email-body{padding:1.05rem;background:var(--bg-elev)}
.email-body .field{margin-bottom:.35rem;font-family:var(--font-mono);font-size:.75rem;display:flex;gap:.5rem}
.field-label{color:var(--text-faint);min-width:48px}
.field-value{color:var(--text-dim)}
.email-body .message{margin-top:.8rem;padding-top:.8rem;border-top:1px dashed var(--border);color:var(--text-dim);font-size:.85rem;line-height:1.7}
.suspicious{background:var(--danger-soft);border-bottom:2px solid var(--danger);padding:0 3px;border-radius:3px;color:var(--danger);font-weight:600}

/* chat bubbles (smishing) */
.chat-mock{background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.1rem;display:flex;flex-direction:column;gap:.5rem;max-width:340px}
.chat-bubble{max-width:85%;padding:.65rem .9rem;border-radius:14px;font-size:.85rem;line-height:1.5;position:relative}
.chat-bubble.them{align-self:flex-start;background:var(--bg-elev-2);border:1px solid var(--border);border-bottom-left-radius:4px}
.chat-sender{font-size:.68rem;color:var(--text-faint);margin-bottom:.3rem}
.chat-row{display:flex}
.chat-cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.1rem;margin-top:1rem}

/* qr mock */
.qr-mock-wrap{display:flex;align-items:center;gap:1.2rem;margin-top:1rem;flex-wrap:wrap}
.qr-box{width:140px;height:140px;background:repeating-conic-gradient(#000 0% 25%,#fff 0% 50%) 0/16px 16px;border:8px solid var(--bg-elev);border-radius:8px;position:relative;flex-shrink:0}
.qr-warning-stripe{position:absolute;inset:0;background:repeating-linear-gradient(45deg,rgba(232,88,61,.85) 0 10px,rgba(0,0,0,.85) 10px 20px);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.62rem;font-weight:800;text-align:center;padding:.4rem;border-radius:4px}

/* incident stepper */
.stepper{counter-reset:step;margin-top:1rem;display:flex;flex-direction:column;gap:.7rem}
.stepper-item{display:flex;gap:.9rem;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-md);padding:1rem}
.stepper-num{counter-increment:step;width:32px;height:32px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0}
.stepper-num::before{content:counter(step)}
.stepper-body h4{font-size:.9rem;margin-bottom:.2rem}
.stepper-body p{font-size:.83rem;color:var(--text-dim);margin:0}
.stepper-body input[type=checkbox]{margin-right:.4rem;accent-color:var(--accent)}

.report-box{background:var(--accent-soft);border:1px solid var(--border-strong);border-radius:var(--radius-md);padding:1.1rem;margin-top:1rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}

/* analyzer */
.analyze-container{max-width:980px;margin:0 auto}
.channel-toggle{display:inline-flex;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-sm);padding:3px;margin-bottom:1rem}
.channel-btn{background:transparent;border:none;padding:.5rem 1rem;border-radius:6px;font-size:.82rem;font-weight:600;color:var(--text-dim);cursor:pointer}
.channel-btn.active{background:var(--accent);color:#fff}
.sample-buttons{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}
.sample-btn{background:var(--bg-elev);border:1px solid var(--border);color:var(--accent);padding:.42rem .8rem;border-radius:var(--radius-sm);font-size:.76rem;cursor:pointer}
.email-textarea{width:100%;min-height:200px;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-md);padding:1rem;font-family:var(--font-mono);font-size:.86rem;color:var(--text);resize:vertical;line-height:1.7}
.email-textarea:focus{border-color:var(--accent)}
.btn-scan{width:100%;padding:1rem 1.6rem;background:var(--accent);border:none;border-radius:var(--radius-md);color:#fff;font-size:.9rem;font-weight:700;cursor:pointer;letter-spacing:.5px;margin-top:1rem;box-shadow:var(--shadow-sm)}
.btn-scan:hover:not(:disabled){background:var(--accent-2)}
.btn-scan:disabled{opacity:.6;cursor:not-allowed}
.terminal-output{background:#0b1120;border:1px solid var(--border);border-radius:var(--radius-md);padding:1.1rem;margin-top:1.3rem;font-family:var(--font-mono);font-size:.8rem;max-height:300px;overflow-y:auto;display:none;color:#c7d0e6}
.terminal-output.active{display:block}
.terminal-line{margin-bottom:.3rem;opacity:0;animation:typeIn .25s ease forwards}
@keyframes typeIn{to{opacity:1}}
.terminal-line .prefix{color:var(--safe);font-weight:700}
.terminal-line .info{color:#7bb7ff}
.terminal-line .warn{color:var(--warn)}
.terminal-line .error{color:var(--danger);font-weight:700}
.terminal-line .muted{color:#5b6a86}
.results-container{margin-top:1.4rem;display:none}
.results-container.active{display:block}
.result-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.4rem;margin-bottom:1rem}
.result-card-title{font-size:.74rem;color:var(--text-faint);margin-bottom:1.1rem;text-transform:uppercase;letter-spacing:1.5px}
.results-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:768px){.results-grid{grid-template-columns:1fr}}
.results-grid .full-width{grid-column:1/-1}
.meter-container{text-align:center;padding:.5rem 0}
.meter-value{font-family:var(--font-mono);font-size:2.6rem;font-weight:700}
.meter-bar-track{width:100%;height:10px;background:var(--bg-elev-2);border-radius:6px;overflow:hidden;margin-top:.6rem}
.meter-bar-fill{height:100%;width:0;border-radius:6px;transition:width 1s var(--ease)}
.meter-label{font-size:.8rem;color:var(--text-dim);margin-top:.5rem}
.stamp{display:inline-block;padding:.55rem 1.5rem;border:3px solid currentColor;border-radius:8px;font-family:var(--font-mono);font-weight:800;letter-spacing:2px;text-transform:uppercase;transform:rotate(-3deg);font-size:.92rem}
.stamp.safe{color:var(--safe)}
.stamp.suspicious{color:var(--warn)}
.stamp.danger{color:var(--danger)}
.signals-list{list-style:none}
.signal-item{display:flex;gap:.8rem;padding:.85rem;margin-bottom:.55rem;border-radius:var(--radius-md);background:var(--bg-elev);border-left:3px solid transparent}
.signal-item.severity-high{border-left-color:var(--danger)}
.signal-item.severity-medium{border-left-color:var(--warn)}
.signal-item.severity-low{border-left-color:var(--accent)}
.signal-info{flex:1}
.signal-info h5{font-size:.86rem;margin-bottom:.2rem}
.signal-info p{font-size:.78rem;color:var(--text-dim);margin:0}
.signal-severity{font-size:.62rem;padding:.2rem .55rem;border-radius:10px;text-transform:uppercase;font-weight:700;height:fit-content}
.severity-high .signal-severity{background:var(--danger-soft);color:var(--danger)}
.severity-medium .signal-severity{background:var(--warn-soft);color:var(--warn)}
.severity-low .signal-severity{background:var(--accent-soft);color:var(--accent)}
.recommendations{list-style:none}
.recommendations li{padding:.65rem 0;border-bottom:1px solid var(--border);color:var(--text-dim);font-size:.88rem;display:flex;gap:.6rem}
.recommendations li:last-child{border-bottom:none}
.disclaimer{background:var(--warn-soft);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.05rem;margin-top:1.3rem;display:flex;gap:.8rem;font-size:.83rem;color:var(--text-dim)}

/* quiz */
.quiz-container{max-width:880px;margin:0 auto}
.quiz-start-screen,.quiz-result-screen{text-align:center;padding:2.5rem 1.5rem}
.quiz-start-screen h2{font-size:1.6rem;margin-bottom:.7rem}
.quiz-start-screen p{color:var(--text-dim);max-width:560px;margin:0 auto 1.6rem}
.quiz-stats-preview{display:flex;justify-content:center;gap:1.5rem;margin:1.6rem 0;flex-wrap:wrap}
.stat-card{background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-md);padding:.9rem 1.3rem;min-width:110px}
.stat-card .value{font-family:var(--font-mono);font-size:1.6rem;font-weight:700;color:var(--accent);display:block}
.stat-card .label{font-size:.72rem;color:var(--text-faint);text-transform:uppercase}
.btn-primary{background:var(--accent);border:none;color:#fff;padding:.85rem 1.9rem;border-radius:var(--radius-md);font-size:.88rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.5rem}
.btn-primary:hover{background:var(--accent-2)}
.btn-secondary{background:transparent;border:1px solid var(--border-strong);color:var(--text);padding:.65rem 1.3rem;border-radius:var(--radius-md);font-size:.83rem;cursor:pointer;margin:.25rem}
.btn-secondary:hover{background:var(--bg-elev)}
.quiz-progress-wrapper{margin-bottom:1.6rem}
.quiz-progress-header{display:flex;justify-content:space-between;margin-bottom:.5rem;font-size:.8rem;color:var(--text-dim)}
.quiz-progress-bar{width:100%;height:7px;background:var(--bg-elev-2);border-radius:4px;overflow:hidden}
.quiz-progress-fill{height:100%;background:var(--accent);width:0;transition:width .5s}
.quiz-question-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden}
.quiz-meta-row{display:flex;gap:.5rem;padding:.9rem 1.4rem 0}
