<script>
/* ---------- STORAGE (persistent artifact storage, no localStorage) ---------- */
const DB={
  async get(key,shared=false,def=null){
    try{const r=await window.storage.get(key,shared);return r?JSON.parse(r.value):def}catch(e){return def}
  },
  async set(key,value,shared=false){
    try{await window.storage.set(key,JSON.stringify(value),shared);return true}catch(e){console.warn('storage set failed',e);return false}
  },
  async list(prefix,shared=false){
    try{const r=await window.storage.list(prefix,shared);return r?r.keys:[]}catch(e){return []}
  }
};
const KEYS={profile:'profile',stats:'stats',achievements:'achievements',theme:'theme',hacker:'hacker_mode'};
function defaultStats(){return{analyses:0,threats:0,quizzes:0,quizCorrect:0,quizTotal:0,avgScore:0,lastPerfect:false,last7Days:[0,0,0,0,0,0,0],threatTypes:{urgency:0,links:0,sensitive:0,structure:0,sms:0}}}

let PROFILE=null, STATS=null;

/* ---------- TOAST ---------- */
const Toast={show(type,title,message,duration=4000){const c=document.getElementById('toastContainer');const t=document.createElement('div');t.className=`toast ${type}`;const icons={success:'✓',error:'✕',warning:'⚠',info:'ℹ',achievement:'🏆'};t.innerHTML=`<div class="toast-icon">${icons[type]||'ℹ'}</div><div><div class="toast-title">${title}</div><div class="toast-message">${message}</div></div>`;c.appendChild(t);setTimeout(()=>t.remove(),duration)}};

/* ---------- PROFILE / ONBOARDING ---------- */
const Onboarding={
  async init(){
    PROFILE=await DB.get(KEYS.profile,false,null);
    if(!PROFILE){document.getElementById('onboardModal').hidden=false;document.getElementById('inputName').focus()}
    else this.renderChip();
  },
  renderChip(){
    const chip=document.getElementById('studentChip');
    if(PROFILE&&PROFILE.name){chip.hidden=false;document.getElementById('studentChipText').textContent=`${PROFILE.name}${PROFILE.turma?' · '+PROFILE.turma:''}`}
    else chip.hidden=true;
  },
  async save(name,turma){
    const id=(PROFILE&&PROFILE.id)?PROFILE.id:(crypto.randomUUID?crypto.randomUUID():'s-'+Date.now()+Math.random().toString(16).slice(2));
    PROFILE={id,name:name||'Aluno(a)',turma:turma||''};
    await DB.set(KEYS.profile,PROFILE,false);
    this.renderChip();
    document.getElementById('onboardModal').hidden=true;
    Toast.show('success','Perfil salvo',`Bem-vindo(a), ${PROFILE.name}!`);
  }
};

/* ---------- THEME ---------- */
const Theme={
  async init(){
    const saved=await DB.get(KEYS.theme,false,'dark');
    this.apply(saved,false);
    document.querySelectorAll('.toggle-btn').forEach(btn=>btn.addEventListener('click',()=>this.apply(btn.dataset.theme,true)));
    const hacker=await DB.get(KEYS.hacker,false,false);
    document.getElementById('hackerToggle').checked=!!hacker;
    document.body.classList.toggle('hacker-mode',!!hacker);
    if(hacker)Matrix.start();
    document.getElementById('hackerToggle').addEventListener('change',async e=>{
      document.body.classList.toggle('hacker-mode',e.target.checked);
      await DB.set(KEYS.hacker,e.target.checked,false);
      if(e.target.checked)Matrix.start();
    });
  },
  apply(theme,persist){
    document.documentElement.setAttribute('data-theme',theme);
    document.querySelectorAll('.toggle-btn').forEach(b=>b.classList.toggle('active',b.dataset.theme===theme));
    if(persist)DB.set(KEYS.theme,theme,false);
    if(Dashboard.chartsInitialized)Dashboard.updateCharts();
  }
};

/* ---------- MATRIX (optional hacker mode) ---------- */
const Matrix={started:false,canvas:null,ctx:null,columns:[],fontSize:14,
  start(){if(this.started)return;this.started=true;this.canvas=document.getElementById('matrix-canvas');this.ctx=this.canvas.getContext('2d');this.resize();window.addEventListener('resize',()=>this.resize());this.loop()},
  resize(){this.canvas.width=window.innerWidth;this.canvas.height=window.innerHeight;this.columns=[];const cols=Math.floor(this.canvas.width/this.fontSize);for(let i=0;i<cols;i++)this.columns[i]=Math.random()*-100},
  loop(){const chars='01アイウエオカキクケコサシスセソ';const draw=()=>{if(!document.body.classList.contains('hacker-mode')){requestAnimationFrame(draw);return}this.ctx.fillStyle='rgba(11,17,32,0.08)';this.ctx.fillRect(0,0,this.canvas.width,this.canvas.height);this.ctx.fillStyle='#4c6fff';this.ctx.font=this.fontSize+'px monospace';for(let i=0;i<this.columns.length;i++){const ch=chars[Math.floor(Math.random()*chars.length)];const x=i*this.fontSize;const y=this.columns[i]*this.fontSize;this.ctx.fillText(ch,x,y);if(y>this.canvas.height&&Math.random()>0.975)this.columns[i]=0;this.columns[i]++}requestAnimationFrame(draw)};draw()}
};

/* ---------- TABS ---------- */
function switchTab(tabName){
  document.querySelectorAll('.tab-btn').forEach(b=>{const active=b.dataset.tab===tabName;b.classList.toggle('active',active);b.setAttribute('aria-selected',active)});
  document.querySelectorAll('.tab-content').forEach(c=>c.classList.toggle('active',c.id==='tab-'+tabName));
  if(tabName==='dashboard'){Dashboard.updateStats();Achievements.render();Dashboard.updateCharts();Dashboard.renderLeaderboard()}
  window.scrollTo({top:0,behavior:'smooth'});
}

/* ---------- ACHIEVEMENTS ---------- */
const Achievements={
  definitions:[
    {id:'first_quiz',name:'Primeiro Passo',desc:'Concluiu seu primeiro quiz',icon:'🎯',cond:s=>s.quizzes>=1},
    {id:'analyst_10',name:'Analista Júnior',desc:'Analisou 10 mensagens',icon:'🔍',cond:s=>s.analyses>=10},
    {id:'analyst_50',name:'Analista Sênior',desc:'Analisou 50 mensagens',icon:'🕵️',cond:s=>s.analyses>=50},
    {id:'detective',name:'Detetive Digital',desc:'Detectou 25 golpes',icon:'🔦',cond:s=>s.threats>=25},
    {id:'expert',name:'Especialista',desc:'Acertou 80%+ no quiz (3+)',icon:'🏆',cond:s=>s.avgScore>=80&&s.quizzes>=3},
    {id:'master',name:'Mestre em Segurança',desc:'Concluiu 10 quizzes',icon:'👑',cond:s=>s.quizzes>=10},
    {id:'perfect',name:'Perfeição',desc:'Quiz com 100% de acerto',icon:'⭐',cond:s=>s.lastPerfect===true}
  ],
  async check(stats){
    let unlocked=await DB.get(KEYS.achievements,false,[]);
    let fresh=[];
    this.definitions.forEach(d=>{if(!unlocked.includes(d.id)&&d.cond(stats)){unlocked.push(d.id);fresh.push(d)}});
    if(fresh.length){await DB.set(KEYS.achievements,unlocked,false);fresh.forEach(a=>{Toast.show('achievement','Conquista desbloqueada!',`${a.icon} ${a.name}`);if(typeof confetti!=='undefined')confetti({particleCount:80,spread:70,origin:{y:.6}})})}
    return unlocked;
  },
  async render(){
    const grid=document.getElementById('achievementsGrid');
    const unlocked=await DB.get(KEYS.achievements,false,[]);
    grid.innerHTML=this.definitions.map(d=>{const u=unlocked.includes(d.id);return `<div class="achievement-card ${u?'unlocked':'locked'}"><span class="achievement-icon">${d.icon}</span><div class="achievement-name">${d.name}</div><div class="achievement-desc">${d.desc}</div></div>`}).join('');
  }
};

/* ---------- HEURISTICS ---------- */
const Heuristics={
  rules:{
    urgency:[
      {pattern:/urgente[s]?/gi,name:"Palavra de urgência",desc:"Uso de 'urgente' para pressionar decisão rápida.",severity:"medium",score:8},
      {pattern:/conta\s+(bloqueada|suspensa|cancelada)/gi,name:"Ameaça de bloqueio",desc:"Ameaça de bloqueio/suspensão de conta.",severity:"high",score:15},
      {pattern:/último\s+aviso/gi,name:"Último aviso",desc:"'Último aviso' indica pressão extrema.",severity:"high",score:14},
      {pattern:/em\s+(24|48|12|2)\s*(horas|h|hrs)/gi,name:"Prazo artificial",desc:"Prazo curto artificial para criar urgência.",severity:"high",score:12},
