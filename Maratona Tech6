st isThreat=results.score>=40;const threatCats=[];if(results.categories.urgency>0)threatCats.push('urgency');if(results.categories.links>0)threatCats.push('links');if(results.categories.sensitive>0)threatCats.push('sensitive');if(results.categories.structure>0)threatCats.push('structure');Storage.recordAnalysis(isThreat,threatCats);if(isThreat)Toast.show('error','Ameaça Detectada',`Risco: ${results.score}/100`);else Toast.show('success','Análise Completa','Mensagem parece segura.');Dashboard.updateStats();Achievements.check(Storage.get(Storage.keys.stats,Storage.getDefaultStats()));btn.disabled=false;btn.innerHTML=' EXECUTAR VARREDURA HEURÍSTICA'},displayResults(results){const container=document.getElementById('resultsContainer');container.classList.add('active');this.animateMeter(results.score,'meterNeedle','meterValue');const badge=document.getElementById('verdictBadge');badge.textContent=results.verdict;badge.className='verdict-badge '+results.verdictClass;document.getElementById('verdictDescription').textContent=results.verdictDesc;const signalsList=document.getElementById('signalsList');if(results.signals.length===0){signalsList.innerHTML='<li style="color:var(--text-muted);text-align:center;padding:1rem">✅ Nenhum sinal de phishing detectado.</li>'}else{const severityOrder={high:0,medium:1,low:2};results.signals.sort((a,b)=>severityOrder[a.severity]-severityOrder[b.severity]);signalsList.innerHTML=results.signals.map(s=>`<li class="signal-item severity-${s.severity}"><span class="signal-icon">${s.icon}</span><div class="signal-info"><h5>${s.name} ${s.count>1?`(×${s.count})`:''}</h5><p>${s.desc} <span style="color:var(--text-muted);font-size:0.72rem">(+${s.score} pontos)</span></p></div><span class="signal-severity">${s.severity==='high'?'ALTO':s.severity==='medium'?'MÉDIO':'BAIXO'}</span></li>`).join('')}const recsList=document.getElementById('recommendationsList');const recs=Heuristics.generateRecommendations(results.signals);recsList.innerHTML=recs.map(r=>`<l