        <div class="stat-card-dashboard"><div class="stat-icon" style="background:rgba(0,255,65,0.15);color:var(--accent-primary)">📧</div><div class="stat-value" id="stat-analyses">0</div><div class="stat-label">E-mails Analisados</div></div>
        <div class="stat-card-dashboard"><div class="stat-icon" style="background:rgba(255,51,102,0.15);color:var(--accent-danger)">⚠️</div><div class="stat-value" id="stat-threats">0</div><div class="stat-label">Golpes Detectados</div></div>
        <div class="stat-card-dashboard"><div class="stat-icon" style="background:rgba(0,255,136,0.15);color:var(--accent-success)">🎯</div><div class="stat-value" id="stat-quizzes">0</div><div class="stat-label">Quizzes Concluídos</div></div>
        <div class="stat-card-dashboard"><div class="stat-icon" style="background:rgba(255,184,0,0.15);color:var(--accent-warning)">🏆</div><div class="stat-value" id="stat-avg-score">0%</div><div class="stat-label">Pontuação Média</div></div>
