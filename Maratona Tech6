const Dashboard={chartsInitialized:false,charts:{},init(){this.updateStats();Achievements.render();this.initCharts();this.renderHistory()},updateStats(){const stats=Storage.get(Storage.keys.stats,Storage.getDefaultStats());this.animateNumber('stat-analyses',stats.analyses||0);this.animateNumber('stat-threats',stats.threats||0);this.animateNumber('stat-quizzes',stats.quizzes||0);document.getElementById('stat-avg-score').textContent=(stats.avgScore||0)+'%'},animateNumber(id,target){const el=document.getElementById(id);if(!el)return;const current=parseInt(el.textContent)||0;if(current===target)return;const steps=30;const increment=(target-current)/steps;let value=current;let i=0;const interval=setInterval(()=>{i++;value+=increment;if(i>=steps){value=target;clearInterval(interval)}el.textContent=Math.round(value)},20)},initCharts(){if(typeof Chart==='undefined'){console.warn('Chart.js não carregado');return}const stats=Storage.get(Storage.keys.stats,Storage.getDefaultStats());const textColor=getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim();const gridColor=getComputedStyle(document.documentElement).getPropertyValue('--border-color').trim();Chart.defaults.color=textColor;Chart.defaults.borderColor=gridColor;Chart.defaults.font.family="'Inter',sans-serif";const ctx1=document.getElementById('chart-analyses');if(ctx1){const days=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];const today=new Date().getDay();const labels=[];const data=[];const last7=stats.last7Days||[0,0,0,0,0,0,0];for(let i=6;i>=0;i--){const dayIndex=(today-i+7)%7;labels.push(days[dayIndex]);data.push(last7[dayIndex]||0)}this.charts.analyses=new Chart(ctx1,{type:'line',data:{labels:labels,datasets:[{label:'Análises',data:data,borderColor:'#00ff41',backgroundColor:'rgba(0,255,65,0.1)',tension:0.4,fill:true,borderWidth:2,pointBackgroundColor:'#00ff41',pointBorderColor:'#fff',pointBorderWidth:2,pointRadius:4,pointHoverRadius:6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{stepSize:1},grid:{color:gridColor}},x:{grid:{display:false}}}}})}const ctx2=document.getElementById('chart-threats');if(ctx2){const threatTypes=stats.threatTypes||{urgency:0,links:0,sensitive:0,structure:0};const data=[threatTypes.urgency||0,threatTypes.links||0,threatTypes.sensitive||0,threatTypes.structure||0];this.charts.threats=new Chart(ctx2,{type:'doughnut',data:{labels:['Urgência','Links','Dados','Estrutura'],datasets:[{data:data,backgroundColor:['#ff3366','#ffb800','#00d9ff','#7b2cff'],borderColor:'#0a0f1c',borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,cutout:'60%',plugins:{legend:{position:'bottom',labels:{padding:15,font:{size:11}}}}}})}this.chartsInitialized=true},updateCharts(){if(!this.chartsInitialized)return;const stats=Storage.get(Storage.keys.stats,Storage.getDefaultStats());if(this.charts.analyses){const today=new Date().getDay();const last7=stats.last7Days||[0,0,0,0,0,0,0];const data=[];for(let i=6;i>=0;i--){const dayIndex=(today-i+7)%7;data.push(last7[dayIndex]||0)}this.charts.analyses.data.datasets[0].data=data;this.charts.analyses.update()}if(this.charts.threats){const threatTypes=stats.threatTypes||{urgency:0,links:0,sensitive:0,structure:0};this.charts.threats.data.datasets[0].data=[threatTypes.urgency||0,threatTypes.links||0,threatTypes.sensitive||0,threatTypes.structure||0];this.charts.threats.update()}},renderHistory(){const tbody=document.getElementById('historyBody');const history=Storage.get(Storage.keys.history,[]);if(history.length===0){tbody.innerHTML='<tr><td colspan="3" style="text-align:center;color:var(--text-muted)">Nenhum registro ainda. Complete um quiz ou análise!</td></tr>';return}tbody.innerHTML=history.slice(0,10).map(h=>`<tr><td>${h.date}</td><td>${h.activity}</td><td><span style="color:${h.result.includes('Ameaça')||h.result.includes('Erro')?'var(--accent-danger)':'var(--accent-success)'}">${h.result}</span></td></tr>`).join('')}};

