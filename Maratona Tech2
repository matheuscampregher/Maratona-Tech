<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Sentinel Mail - Plataforma profissional de defesa contra phishing">
<title>SENTINEL MAIL // Vigilância Inteligente contra Phishing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<style>
/* ============================================
   RESET & ROOT VARIABLES
   ============================================ */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  /* Dark theme (default) */
  --bg-primary: #05070d;
  --bg-secondary: #0a0f1c;
  --bg-tertiary: #0f1524;
  --bg-card: rgba(18, 24, 40, 0.7);
  --bg-card-hover: rgba(25, 33, 55, 0.85);
  --bg-glass: rgba(15, 21, 36, 0.55);
  
  --accent-primary: #00d9ff;
  --accent-secondary: #0077ff;
  --accent-tertiary: #7b2cff;
  --accent-success: #00ff88;
  --accent-warning: #ffb800;
  --accent-danger: #ff3366;
  --accent-info: #00d4ff;
  
  --text-primary: #e8edf7;
  --text-secondary: #9aa7c2;
  --text-muted: #5a6882;
  --text-inverse: #05070d;
  
  --border-color: rgba(100, 130, 180, 0.15);
  --border-accent: rgba(0, 217, 255, 0.3);
  --border-glow: rgba(0, 217, 255, 0.5);
  
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.5);
  --shadow-glow: 0 0 32px rgba(0, 217, 255, 0.25);
  --shadow-glow-danger: 0 0 32px rgba(255, 51, 102, 0.3);
  
  --gradient-primary: linear-gradient(135deg, #00d9ff 0%, #0077ff 50%, #7b2cff 100%);
  --gradient-accent: linear-gradient(135deg, #00ff88 0%, #00d9ff 100%);
  --gradient-danger: linear-gradient(135deg, #ff3366 0%, #ff0080 100%);
  --gradient-warning: linear-gradient(135deg, #ffb800 0%, #ff6b00 100%);
  --gradient-bg: radial-gradient(ellipse at top, #0a1530 0%, #05070d 50%);
  
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
  
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 400ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Light theme */
[data-theme="light"] {
  --bg-primary: #f5f7fb;
  --bg-secondary: #ffffff;
  --bg-tertiary: #eef2f9;
  --bg-card: rgba(255, 255, 255, 0.85);
  --bg-card-hover: rgba(255, 255, 255, 0.95);
  --bg-glass: rgba(255, 255, 255, 0.7);
  
  --accent-primary: #0077ff;
  --accent-secondary: #0055cc;
  --accent-tertiary: #6b1fd9;
  --accent-success: #00a855;
  --accent-warning: #e68a00;
  --accent-danger: #d91640;
  
  --text-primary: #0a1128;
  --text-secondary: #4a5878;
  --text-muted: #8090aa;
  --text-inverse: #ffffff;
  
  --border-color: rgba(100, 130, 180, 0.18);
  --border-accent: rgba(0, 119, 255, 0.35);
  
  --shadow-sm: 0 2px 8px rgba(100, 130, 180, 0.08);
  --shadow-md: 0 8px 24px rgba(100, 130, 180, 0.12);
  --shadow-lg: 0 16px 48px rgba(100, 130, 180, 0.18);
  --shadow-glow: 0 0 24px rgba(0, 119, 255, 0.15);
  
  --gradient-bg: radial-gradient(ellipse at top, #e8f0ff 0%, #f5f7fb 50%);
}

/* ============================================
   BASE
   ============================================ */
html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-sans);
  background: var(--bg-primary);
  background-image: var(--gradient-bg);
  background-attachment: fixed;
  color: var(--text-primary);
  min-height: 100vh;
  line-height: 1.6;
  overflow-x: hidden;
  transition: background var(--transition-base), color var(--transition-base);
}

/* Particle background */
#particles-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  opacity: 0.4;
}

[data-theme="light"] #particles-canvas {
  opacity: 0.25;
}

/* Scrollbar */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg-secondary); }
::-webkit-scrollbar-thumb { 
  background: linear-gradient(180deg, var(--accent-primary), var(--accent-secondary));
  border-radius: 5px;
}
::-webkit-scrollbar-thumb:hover { background: var(--accent-primary); }

/* ============================================
   LOADING SCREEN
   ============================================ */
.loading-screen {
  position: fixed;
  inset: 0;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  transition: opacity 0.6s ease, visibility 0.6s ease;
}

.loading-screen.hidden {
  opacity: 0;
  visibility: hidden;
}

.loading-logo {
  width: 80px;
  height: 80px;
  margin-bottom: 2rem;
  animation: pulse 2s ease-in-out infinite;
}

.loading-spinner {
  width: 50px;
  height: 50px;
  border: 3px solid var(--border-color);
  border-top-color: var(--accent-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 1rem;
}

.loading-text {
  font-family: var(--font-mono);
  color: var(--text-secondary);
  font-size: 0.85rem;
  letter-spacing: 2px;
}

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.85; }
}

/* ============================================
   HEADER
   ============================================ */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg-glass);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid var(--border-color);
  padding: 0.9rem 2rem;
}

.header-content {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  cursor: pointer;
  transition: transform var(--transition-base);
}

.logo:hover { transform: translateY(-2px); }

.logo-icon {
  width: 44px;
  height: 44px;
  background: var(--gradient-primary);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
  position: relative;
  overflow: hidden;
}

.logo-icon::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.logo-icon svg {
  width: 26px;
  height: 26px;
  color: white;
  z-index: 1;
}

.logo-text-group {
  display: flex;
  flex-direction: column;
}

.logo-title {
  font-family: var(--font-mono);
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-subtitle {
  font-size: 0.68rem;
  color: var(--text-muted);
  font-family: var(--font-mono);
  letter-spacing: 2.5px;
  text-transform: uppercase;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--accent-success);
  padding: 0.4rem 0.8rem;
  background: rgba(0, 255, 136, 0.08);
  border: 1px solid rgba(0, 255, 136, 0.2);
  border-radius: 20px;
}

.status-dot {
  width: 8px;
  height: 8px;
  background: var(--accent-success);
  border-radius: 50%;
  animation: blink 2s ease-in-out infinite;
  box-shadow: 0 0 8px var(--accent-success);
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* Theme toggle */
.theme-toggle {
  display: flex;
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 3px;
  gap: 2px;
}

.theme-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  padding: 6px 10px;
  border-radius: 7px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
  font-size: 0.95rem;
}

.theme-btn:hover { color: var(--text-primary); }

.theme-btn.active {
  background: var(--gradient-primary);
  color: white;
  box-shadow: var(--shadow-sm);
}

/* ============================================
   TABS
   ============================================ */
.tabs-wrapper {
  max-width: 1400px;
  margin: 1.5rem auto 0;
  padding: 0 2rem;
}

.tabs {
  display: flex;
  gap: 4px;
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 5px;
  overflow-x: auto;
  scrollbar-width: thin;
}

.tab-btn {
  flex-shrink: 0;
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 0.85rem;
  font-weight: 500;
  padding: 0.6rem 1.1rem;
  cursor: pointer;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
  display: flex;
  align-items: center;
  gap: 0.45rem;
  white-space: nowrap;
}

.tab-btn:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.03);
}

.tab-btn.active {
  background: var(--gradient-primary);
  color: white;
  box-shadow: var(--shadow-sm);
}

.tab-btn .tab-icon { font-size: 1rem; }

/* ============================================
   MAIN CONTENT
   ============================================ */
.main-content {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
  position: relative;
  z-index: 1;
}

.tab-content {
  display: none;
  animation: fadeInUp 0.5s ease;
}

.tab-content.active { display: block; }

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================
   CARDS & GLASSMORPHISM
   ============================================ */
.card {
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.75rem;
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
  opacity: 0;
  transition: opacity var(--transition-base);
}

.card:hover {
  background: var(--bg-card-hover);
  border-color: var(--border-accent);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.card:hover::before { opacity: 1; }

.section-title {
  font-family: var(--font-mono);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  letter-spacing: 0.5px;
}

.section-title .title-icon {
  width: 28px;
  height: 28px;
  background: var(--gradient-primary);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  box-shadow: 0 0 12px rgba(0, 217, 255, 0.3);
}

.section {
  margin-bottom: 2rem;
  animation: fadeInUp 0.5s ease backwards;
}

.section:nth-child(2) { animation-delay: 0.1s; }
.section:nth-child(3) { animation-delay: 0.2s; }
.section:nth-child(4) { animation-delay: 0.3s; }
.section:nth-child(5) { animation-delay: 0.4s; }

/* ============================================
   HIGHLIGHTS
   ============================================ */
.highlight { color: var(--accent-primary); font-weight: 600; }
.highlight-success { color: var(--accent-success); font-weight: 600; }
.highlight-warning { color: var(--accent-warning); font-weight: 600; }
.highlight-danger { color: var(--accent-danger); font-weight: 600; }
.highlight-purple { color: var(--accent-tertiary); font-weight: 600; }

.text-muted { color: var(--text-muted); }
.text-secondary { color: var(--text-secondary); }

/* ============================================
   ANALOGY BOX
   ============================================ */
.analogy-box {
  background: linear-gradient(135deg, rgba(0, 217, 255, 0.08), rgba(123, 44, 255, 0.08));
  border: 1px solid var(--border-accent);
  border-radius: var(--radius-md);
  padding: 1.1rem 1.25rem;
  margin-top: 1rem;
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.analogy-box .icon {
  font-size: 1.6rem;
  flex-shrink: 0;
}

.analogy-box p {
  margin: 0;
  font-style: italic;
  color: var(--text-secondary);
  font-size: 0.9rem;
}

/* ============================================
   FLOW TIMELINE (Horizontal)
   ============================================ */
.timeline-horizontal {
  display: flex;
  align-items: stretch;
  gap: 0;
  margin-top: 1.5rem;
  overflow-x: auto;
  padding: 1rem 0;
  position: relative;
}

.timeline-step {
  flex: 1;
  min-width: 110px;
  position: relative;
  padding: 0 0.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.timeline-step::after {
  content: '';
  position: absolute;
  top: 22px;
  right: -20%;
  width: 40%;
  height: 2px;
  background: linear-gradient(90deg, var(--accent-primary), transparent);
  opacity: 0.4;
}

.timeline-step:last-child::after { display: none; }

.step-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  margin-bottom: 0.6rem;
  box-shadow: 0 0 16px rgba(0, 217, 255, 0.3);
  position: relative;
  z-index: 1;
  animation: floatIcon 3s ease-in-out infinite;
}

.timeline-step:nth-child(even) .step-icon {
  animation-delay: 0.5s;
  background: var(--gradient-danger);
  box-shadow: 0 0 16px rgba(255, 51, 102, 0.3);
}

@keyframes floatIcon {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

.step-title {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.2rem;
}

.step-desc {
  font-size: 0.7rem;
  color: var(--text-muted);
}

/* ============================================
   SIGNS GRID
   ============================================ */
.signs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}

.sign-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.1rem;
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  transition: all var(--transition-base);
  cursor: default;
}

.sign-item:hover {
  border-color: var(--border-accent);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.sign-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(255, 184, 0, 0.1);
  border: 1px solid rgba(255, 184, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  flex-shrink: 0;
}

.sign-item h4 {
  font-size: 0.88rem;
  color: var(--accent-warning);
  margin-bottom: 0.25rem;
  font-weight: 600;
}

.sign-item p {
  font-size: 0.82rem;
  color: var(--text-secondary);
  margin: 0;
  line-height: 1.5;
}

/* ============================================
   CHECKLIST
   ============================================ */
.checklist {
  list-style: none;
  margin-top: 1rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 0.65rem;
}

.checklist li {
  padding: 0.85rem 1rem;
  background: rgba(0, 255, 136, 0.04);
  border: 1px solid rgba(0, 255, 136, 0.12);
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  color: var(--text-secondary);
  transition: all var(--transition-base);
  font-size: 0.88rem;
}

.checklist li:hover {
  background: rgba(0, 255, 136, 0.08);
  border-color: rgba(0, 255, 136, 0.35);
  transform: translateX(3px);
}

.checklist li .check-icon {
  color: var(--accent-success);
  font-size: 1.1rem;
  flex-shrink: 0;
  margin-top: 1px;
}

.checklist li strong { color: var(--text-primary); }

/* ============================================
   COMPARISON
   ============================================ */
.comparison-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-top: 1rem;
}

@media (max-width: 768px) {
  .comparison-container { grid-template-columns: 1fr; }
}

.email-example {
  border-radius: var(--radius-lg);
  overflow: hidden;
  font-size: 0.85rem;
  box-shadow: var(--shadow-md);
  transition: transform var(--transition-base);
}

.email-example:hover { transform: translateY(-3px); }

.email-example.legitimate {
  border: 1px solid rgba(0, 255, 136, 0.3);
}

.email-example.phishing {
  border: 1px solid rgba(255, 51, 102, 0.3);
}

.email-header {
  padding: 0.85rem 1.15rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.legitimate .email-header {
  background: linear-gradient(90deg, rgba(0, 255, 136, 0.15), rgba(0, 255, 136, 0.05));
  color: var(--accent-success);
}

.phishing .email-header {
  background: linear-gradient(90deg, rgba(255, 51, 102, 0.15), rgba(255, 51, 102, 0.05));
  color: var(--accent-danger);
}

.email-body {
  padding: 1.15rem;
  background: var(--bg-card);
}

.email-body .field {
  margin-bottom: 0.4rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  display: flex;
  gap: 0.5rem;
}

.field-label {
  color: var(--text-muted);
  font-weight: 500;
  min-width: 50px;
}

.field-value { color: var(--text-secondary); }

.email-body .message {
  margin-top: 0.85rem;
  padding-top: 0.85rem;
  border-top: 1px dashed var(--border-color);
  color: var(--text-secondary);
  font-size: 0.85rem;
  line-height: 1.7;
}

.suspicious {
  background: rgba(255, 51, 102, 0.15);
  border-bottom: 2px wavy var(--accent-danger);
  padding: 0 3px;
  border-radius: 3px;
  color: var(--accent-danger);
  font-weight: 500;
}

/* ============================================
   ANALYZE TAB - Original
   ============================================ */
.analyze-container { max-width: 1000px; margin: 0 auto; }

.email-textarea {
  width: 100%;
  min-height: 220px;
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.1rem;
  font-family: var(--font-mono);
  font-size: 0.88rem;
  color: var(--text-primary);
  resize: vertical;
  transition: all var(--transition-base);
  line-height: 1.7;
}

.email-textarea:focus {
  outline: none;
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.15);
}

.email-textarea::placeholder { color: var(--text-muted); }

.sample-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 1rem 0;
}

.sample-btn {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  color: var(--accent-primary);
  padding: 0.45rem 0.85rem;
  border-radius: var(--radius-sm);
  font-size: 0.78rem;
  font-family: var(--font-mono);
  cursor: pointer;
  transition: all var(--transition-base);
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.sample-btn:hover {
  background: rgba(0, 217, 255, 0.1);
  border-color: var(--border-accent);
  transform: translateY(-1px);
}

.btn-scan {
  width: 100%;
  padding: 1.1rem 2rem;
  background: var(--gradient-accent);
  border: none;
  border-radius: var(--radius-md);
  color: var(--text-inverse);
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-glow);
  margin-top: 1rem;
}

.btn-scan:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(0, 217, 255, 0.4);
}

.btn-scan:active { transform: translateY(0); }

.btn-scan:disabled { opacity: 0.6; cursor: not-allowed; }

.btn-scan::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.6s ease;
}

.btn-scan:hover::before { left: 100%; }

/* Terminal output */
.terminal-output {
  background: #0a0f1c;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  margin-top: 1.5rem;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  max-height: 320px;
  overflow-y: auto;
  display: none;
  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3);
}

[data-theme="light"] .terminal-output {
  background: #1a1f2e;
  color: #e8edf7;
}

.terminal-output.active { display: block; animation: fadeInUp 0.4s ease; }

.terminal-line {
  margin-bottom: 0.35rem;
  opacity: 0;
  animation: typeIn 0.3s ease forwards;
  line-height: 1.5;
}

@keyframes typeIn {
  from { opacity: 0; transform: translateX(-5px); }
  to { opacity: 1; transform: translateX(0); }
}

.terminal-line .prefix { color: var(--accent-success); font-weight: 600; }
.terminal-line .info { color: var(--accent-info); }
.terminal-line .warn { color: var(--accent-warning); }
.terminal-line .error { color: var(--accent-danger); font-weight: 600; }
.terminal-line .muted { color: #6a7a94; }

/* Results */
.results-container { margin-top: 1.5rem; display: none; }
.results-container.active { display: block; animation: fadeInUp 0.5s ease; }

.result-card {
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  margin-bottom: 1rem;
  transition: all var(--transition-base);
}

.result-card:hover {
  border-color: var(--border-accent);
  box-shadow: var(--shadow-md);
}

.result-card-title {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--text-muted);
  margin-bottom: 1.25rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.results-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

@media (max-width: 768px) {
  .results-grid { grid-template-columns: 1fr; }
}

.results-grid .full-width { grid-column: 1 / -1; }

/* Risk Meter - Redesigned */
.meter-container {
  text-align: center;
  padding: 1rem 0;
}

.meter-wrapper {
  position: relative;
  width: 220px;
  height: 120px;
  margin: 0 auto 1rem;
  overflow: hidden;
}

.meter-bg {
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: conic-gradient(
    var(--accent-success) 0deg,
    var(--accent-warning) 90deg,
    var(--accent-danger) 180deg
  );
  clip-path: polygon(0 0, 100% 0, 100% 50%, 0 50%);
  position: relative;
  opacity: 0.9;
}

.meter-bg::after {
  content: '';
  position: absolute;
  top: 30px;
  left: 30px;
  right: 30px;
  bottom: 0;
  background: var(--bg-card);
  border-radius: 50%;
  clip-path: polygon(0 0, 100% 0, 100% 62%, 0 62%);
}

.meter-needle {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 4px;
  height: 90px;
  background: var(--text-primary);
  transform-origin: bottom center;
  transform: translateX(-50%) rotate(-90deg);
  transition: transform 1.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  border-radius: 2px;
  z-index: 2;
  box-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
}

.meter-needle::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 16px;
  height: 16px;
  background: var(--text-primary);
  border-radius: 50%;
  box-shadow: 0 0 16px rgba(255, 255, 255, 0.6);
}

.meter-value {
  font-family: var(--font-mono);
  font-size: 3rem;
  font-weight: 700;
  line-height: 1;
  transition: color 0.5s ease;
  text-shadow: 0 0 20px currentColor;
}

.meter-label {
  font-size: 0.82rem;
  color: var(--text-secondary);
  margin-top: 0.5rem;
  font-family: var(--font-mono);
  letter-spacing: 1px;
}

/* Verdict Badge */
.verdict-badge {
  display: inline-block;
  padding: 0.6rem 1.8rem;
  border-radius: 30px;
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.verdict-badge.legitimate {
  background: linear-gradient(135deg, rgba(0, 255, 136, 0.2), rgba(0, 255, 136, 0.1));
  color: var(--accent-success);
  border: 2px solid rgba(0, 255, 136, 0.5);
  box-shadow: 0 0 20px rgba(0, 255, 136, 0.2);
}

.verdict-badge.suspicious {
  background: linear-gradient(135deg, rgba(255, 184, 0, 0.2), rgba(255, 184, 0, 0.1));
  color: var(--accent-warning);
  border: 2px solid rgba(255, 184, 0, 0.5);
  box-shadow: 0 0 20px rgba(255, 184, 0, 0.2);
}

.verdict-badge.danger {
  background: linear-gradient(135deg, rgba(255, 51, 102, 0.25), rgba(255, 51, 102, 0.1));
  color: var(--accent-danger);
  border: 2px solid rgba(255, 51, 102, 0.6);
  box-shadow: 0 0 24px rgba(255, 51, 102, 0.4);
  animation: dangerPulse 2s ease-in-out infinite;
}

@keyframes dangerPulse {
  0%, 100% { box-shadow: 0 0 24px rgba(255, 51, 102, 0.4); }
  50% { box-shadow: 0 0 36px rgba(255, 51, 102, 0.7); }
}

/* Signals list */
.signals-list { list-style: none; }

.signal-item {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  padding: 0.9rem;
  margin-bottom: 0.6rem;
  border-radius: var(--radius-md);
  background: rgba(0, 0, 0, 0.2);
  border-left: 3px solid transparent;
  transition: all var(--transition-base);
}

[data-theme="light"] .signal-item { background: rgba(0, 0, 0, 0.04); }

.signal-item:hover {
  transform: translateX(4px);
  background: rgba(0, 0, 0, 0.3);
}

.signal-item.severity-high { border-left-color: var(--accent-danger); }
.signal-item.severity-medium { border-left-color: var(--accent-warning); }
.signal-item.severity-low { border-left-color: var(--accent-info); }

.signal-icon { font-size: 1.2rem; flex-shrink: 0; }

.signal-info { flex: 1; }

.signal-info h5 {
  font-size: 0.88rem;
  color: var(--text-primary);
  margin-bottom: 0.25rem;
  font-weight: 600;
}

.signal-info p {
  font-size: 0.8rem;
  color: var(--text-secondary);
  margin: 0;
  line-height: 1.5;
}

.signal-severity {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  padding: 0.2rem 0.6rem;
  border-radius: 10px;
  margin-left: auto;
  flex-shrink: 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 600;
}

.severity-high .signal-severity {
  background: rgba(255, 51, 102, 0.2);
  color: var(--accent-danger);
}

.severity-medium .signal-severity {
  background: rgba(255, 184, 0, 0.2);
  color: var(--accent-warning);
}

.severity-low .signal-severity {
  background: rgba(0, 212, 255, 0.2);
  color: var(--accent-info);
}

/* Recommendations */
.recommendations { list-style: none; }

.recommendations li {
  padding: 0.7rem 0;
  border-bottom: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-size: 0.9rem;
  display: flex;
  align-items: flex-start;
  gap: 0.65rem;
}

.recommendations li:last-child { border-bottom: none; }

.recommendations li .rec-icon {
  color: var(--accent-primary);
  flex-shrink: 0;
  font-size: 1rem;
}

/* Disclaimer */
.disclaimer {
  background: linear-gradient(135deg, rgba(255, 184, 0, 0.08), rgba(255, 184, 0, 0.03));
  border: 1px solid rgba(255, 184, 0, 0.25);
  border-radius: var(--radius-md);
  padding: 1.15rem;
  margin-top: 1.5rem;
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.disclaimer .icon {
  font-size: 1.3rem;
  flex-shrink: 0;
  color: var(--accent-warning);
}

/* ============================================
   INVESTIGATOR MODE
   ============================================ */
.investigator-container { max-width: 1000px; margin: 0 auto; }

.investigation-steps {
  margin-top: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.investigation-step {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  transition: all var(--transition-base);
  opacity: 0.5;
}

.investigation-step.active {
  opacity: 1;
  border-color: var(--border-accent);
  box-shadow: 0 0 20px rgba(0, 217, 255, 0.15);
}

.investigation-step.completed {
  opacity: 1;
  border-color: rgba(0, 255, 136, 0.3);
}

.step-status {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 1.1rem;
  border: 2px solid var(--border-color);
  transition: all var(--transition-base);
}

.investigation-step.active .step-status {
  border-color: var(--accent-primary);
  background: rgba(0, 217, 255, 0.15);
  color: var(--accent-primary);
  animation: pulseRing 1.5s ease-in-out infinite;
}

.investigation-step.completed .step-status {
  border-color: var(--accent-success);
  background: rgba(0, 255, 136, 0.2);
  color: var(--accent-success);
}

@keyframes pulseRing {
  0%, 100% { box-shadow: 0 0 0 0 rgba(0, 217, 255, 0.4); }
  50% { box-shadow: 0 0 0 8px rgba(0, 217, 255, 0); }
}

.step-content { flex: 1; }

.step-title {
  font-family: var(--font-mono);
  font-size: 0.88rem;
  color: var(--text-primary);
  margin-bottom: 0.4rem;
  font-weight: 600;
}

.step-progress {
  width: 100%;
  height: 4px;
  background: var(--bg-tertiary);
  border-radius: 2px;
  overflow: hidden;
}

.step-progress-bar {
  height: 100%;
  background: var(--gradient-primary);
  width: 0;
  transition: width 0.6s ease;
}

.step-result {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--text-muted);
  margin-top: 0.3rem;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.step-result.show { opacity: 1; }

.step-result.success { color: var(--accent-success); }
.step-result.warning { color: var(--accent-warning); }
.step-result.danger { color: var(--accent-danger); }

/* ============================================
   QUIZ
   ============================================ */
.quiz-container { max-width: 900px; margin: 0 auto; }

.quiz-start-screen, .quiz-result-screen {
  text-align: center;
  padding: 3rem 2rem;
}

.quiz-start-screen h2 {
  font-family: var(--font-mono);
  font-size: 1.8rem;
  margin-bottom: 1rem;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.quiz-start-screen p {
  color: var(--text-secondary);
  font-size: 1rem;
  max-width: 600px;
  margin: 0 auto 2rem;
}

.quiz-stats-preview {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin: 2rem 0;
  flex-wrap: wrap;
}

.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1rem 1.5rem;
  min-width: 120px;
}

.stat-card .value {
  font-family: var(--font-mono);
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--accent-primary);
  display: block;
}

.stat-card .label {
  font-size: 0.78rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.btn-primary {
  background: var(--gradient-primary);
  border: none;
  color: white;
  padding: 0.9rem 2.2rem;
  border-radius: var(--radius-md);
  font-family: var(--font-mono);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 1px;
  text-transform: uppercase;
  transition: all var(--transition-base);
  box-shadow: var(--shadow-glow);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(0, 217, 255, 0.4);
}

.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-secondary {
  background: transparent;
  border: 1px solid var(--border-accent);
  color: var(--accent-primary);
  padding: 0.7rem 1.5rem;
  border-radius: var(--radius-md);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  cursor: pointer;
  transition: all var(--transition-base);
  margin: 0.3rem;
}

.btn-secondary:hover {
  background: rgba(0, 217, 255, 0.1);
  transform: translateY(-1px);
}

/* Quiz progress */
.quiz-progress-wrapper {
  margin-bottom: 2rem;
}

.quiz-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.6rem;
}

.quiz-progress-label {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.quiz-progress-bar {
  width: 100%;
  height: 8px;
  background: var(--bg-tertiary);
  border-radius: 4px;
  overflow: hidden;
}

.quiz-progress-fill {
  height: 100%;
  background: var(--gradient-primary);
  width: 0;
  transition: width 0.5s ease;
  border-radius: 4px;
}

/* Quiz question */
.quiz-question-card {
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  overflow: hidden;
  animation: fadeInUp 0.4s ease;
}

.quiz-email-mock {
  background: var(--bg-tertiary);
  padding: 1.5rem;
  border-bottom: 1px solid var(--border-color);
}

.quiz-email-header-mock {
  display: flex;
  gap: 1rem;
  margin-bottom: 0.85rem;
  padding-bottom: 0.85rem;
  border-bottom: 1px dashed var(--border-color);
  flex-wrap: wrap;
}

.quiz-email-field {
  font-family: var(--font-mono);
  font-size: 0.78rem;
}

.quiz-email-field .label {
  color: var(--text-muted);
  margin-right: 0.4rem;
}

.quiz-email-field .value { color: var(--text-primary); font-weight: 500; }

.quiz-email-body {
  font-size: 0.88rem;
  line-height: 1.7;
  color: var(--text-secondary);
  white-space: pre-wrap;
}

.quiz-answers {
  padding: 1.5rem;
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.quiz-answer-btn {
  flex: 1;
  min-width: 150px;
  padding: 1rem;
  background: var(--bg-tertiary);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-base);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.quiz-answer-btn:hover:not(:disabled) {
  border-color: var(--accent-primary);
  transform: translateY(-2px);
}

.quiz-answer-btn.correct {
  background: rgba(0, 255, 136, 0.15);
  border-color: var(--accent-success);
  color: var(--accent-success);
}

.quiz-answer-btn.wrong {
  background: rgba(255, 51, 102, 0.15);
  border-color: var(--accent-danger);
  color: var(--accent-danger);
}

.quiz-answer-btn:disabled { cursor: not-allowed; }

.quiz-feedback {
  padding: 1rem 1.5rem;
  background: var(--bg-tertiary);
  border-top: 1px solid var(--border-color);
  display: none;
  animation: fadeInUp 0.4s ease;
}

.quiz-feedback.show { display: block; }

.quiz-feedback-title {
  font-family: var(--font-mono);
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.quiz-feedback.correct .quiz-feedback-title { color: var(--accent-success); }
.quiz-feedback.wrong .quiz-feedback-title { color: var(--accent-danger); }

.quiz-feedback p {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.quiz-signs {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px dashed var(--border-color);
}

.quiz-sign {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--accent-warning);
  margin-bottom: 0.3rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.quiz-next-btn {
  margin-top: 1rem;
}

/* Quiz result */
.quiz-result-screen {
  text-align: center;
}

.result-score-circle {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  margin: 0 auto 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: conic-gradient(
    var(--accent-primary) 0deg,
    var(--accent-primary) calc(var(--pct) * 3.6deg),
    var(--bg-tertiary) calc(var(--pct) * 3.6deg)
  );
  transition: background 1s ease;
}

.result-score-circle::before {
  content: '';
  position: absolute;
  inset: 12px;
  background: var(--bg-card);
  border-radius: 50%;
}

.result-score-value {
  position: relative;
  z-index: 1;
  font-family: var(--font-mono);
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--accent-primary);
}

.result-score-value small {
  font-size: 1.2rem;
  color: var(--text-muted);
  font-weight: 400;
}

.result-level {
  display: inline-block;
  padding: 0.5rem 1.5rem;
  background: var(--gradient-primary);
  border-radius: 20px;
  color: white;
  font-family: var(--font-mono);
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin: 1rem 0;
}

.result-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 1rem;
  max-width: 500px;
  margin: 2rem auto;
}

/* ============================================
   PROFESSOR MODE
   ============================================ */
.professor-container { max-width: 1000px; margin: 0 auto; }

.professor-controls {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.professor-example-card {
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 1.5rem;
}

.professor-email-view {
  padding: 1.5rem;
  border-bottom: 1px solid var(--border-color);
  background: var(--bg-tertiary);
}

.professor-analysis {
  padding: 1.5rem;
  display: none;
  animation: fadeInUp 0.5s ease;
}

.professor-analysis.revealed { display: block; }

.professor-analysis h4 {
  font-family: var(--font-mono);
  color: var(--accent-primary);
  margin-bottom: 1rem;
  font-size: 0.95rem;
}

.professor-counter {
  text-align: center;
  font-family: var(--font-mono);
  color: var(--text-muted);
  font-size: 0.85rem;
  margin-bottom: 1rem;
}

/* ============================================
   GENERATOR
   ============================================ */
.generator-container { max-width: 900px; margin: 0 auto; }

.generator-brands {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 0.75rem;
  margin: 1.5rem 0;
}

.brand-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.25rem 0.75rem;
  cursor: pointer;
  transition: all var(--transition-base);
  text-align: center;
  display: flex;
