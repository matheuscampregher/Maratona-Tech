  analyze(text) {
    const signals = [];
    let totalScore = 0;
    const categories = { urgency: 0, links: 0, sensitive: 0, structure: 0 };
    
    for (const [category, rules] of Object.entries(this.rules)) {
      for (const rule of rules) {
        const matches = text.match(rule.pattern);
        if (matches) {
          const score = rule.score * Math.min(matches.length, 3);
          totalScore += score;
          categories[category] += score;
          signals.push({
            name: rule.name,
            desc: rule.desc,
            severity: rule.severity,
            count: matches.length,
            score: score,
            category: category,
            icon: rule.severity === 'high' ? '🚨' : rule.severity === 'medium' ? '⚠️' : 'ℹ️'
          });
        }
      }
    }
    
    // Sender domain analysis
    const fromMatch = text.match(/(?:from|de):\s*([^\n]*)/i);
    if (fromMatch) {
      const fromText = fromMatch[1].toLowerCase();
      const brands = ['itau','itau','bradesco','santander','bb','caixa','nubank','paypal','amazon','netflix','mercado','shopee','instagram','whatsapp','receita','correios'];
      const suspiciousTLDs = ['xyz','top','club','click','tk','ml','ga','cf','gq','pw','cc','icu'];
      
      const hasBrand = brands.some(b => fromText.includes(b));
      const hasSuspiciousTLD = suspiciousTLDs.some(t => fromText.includes(`.${t}`));
      const hasHyphenDomain = /@[a-z0-9-]+\.[a-z]/.test(fromText);
      
      if (hasBrand && (hasSuspiciousTLD || hasHyphenDomain)) {
        totalScore += 20;
        categories.structure += 20;
        signals.push({
          name: "Remetente com domínio suspeito",
          desc: "O domínio do remetente mistura marca conhecida com sufixo incomum — tentativa de imitação.",
          severity: "high",
          count: 1,
          score: 20,
          category: "structure",
          icon: "🚨"
        });
      }
    }
    
    totalScore = Math.min(totalScore, 100);
    
    let verdict, verdictClass, verdictDesc;
    if (totalScore >= 70) {
      verdict = "ALTO RISCO DE PHISHING";
      verdictClass = "danger";
      verdictDesc = "Este e-mail apresenta múltiplos indicadores de phishing. NÃO interaja com ele.";
    } else if (totalScore >= 40) {
      verdict = "SUSPEITO";
      verdictClass = "suspicious";
      verdictDesc = "Este e-mail contém elementos suspeitos. Prossiga com cautela.";
    } else if (totalScore >= 20) {
      verdict = "ATENÇÃO";
      verdictClass = "suspicious";
      verdictDesc = "Alguns elementos merecem atenção. Verifique antes de agir.";
    } else {
      verdict = "PROVAVELMENTE LEGÍTIMO";
      verdictClass = "legitimate";
      verdictDesc = "Nenhum indicador forte de phishing detectado.";
    }
    
    return {
      score: totalScore,
      signals,
      categories,
      verdict,
      verdictClass,
      verdictDesc,
      probability: Math.min(95, totalScore)
    };
  },

  generateRecommendations(signals) {
    const recs = [];
    const names = new Set(signals.map(s => s.name));
    
    if (signals.some(s => s.severity === 'high')) {
      recs.push({ icon: "🚫", text: "NÃO clique em nenhum link e NÃO forneça dados pessoais." });
    }
    
    if ([...names].some(n => n.includes("domínio") || n.includes("URL") || n.includes("Link") || n.includes("Encurtador"))) {
      recs.push({ icon: "🌐", text: "Digite o endereço oficial diretamente no navegador, nunca clique em links recebidos." });
    }
    
    if ([...names].some(n => n.includes("senha") || n.includes("CPF") || n.includes("cartão"))) {
      recs.push({ icon: "🔐", text: "Nenhuma empresa legítima pede senha ou dados completos por e-mail." });
    }
    
    if ([...names].some(n => n.includes("urgência") || n.includes("prazo") || n.includes("ameaça"))) {
      recs.push({ icon: "🧘", text: "Respire e não aja por impulso. Empresas reais dão prazos razoáveis." });
    }
    
    if ([...names].some(n => n.includes("Encurtador") || n.includes("IP"))) {
      recs.push({ icon: "🔗", text: "Nunca clique em links encurtados ou com IPs numéricos." });
    }
    
    if ([...names].some(n => n.includes("genérica"))) {
      recs.push({ icon: "📧", text: "E-mails legítimos usam seu nome. Saudações genéricas indicam envio em massa." });
    }
    
    recs.push({ icon: "📞", text: "Em dúvida, contate a empresa pelos canais oficiais (site ou telefone)." });
    recs.push({ icon: "🛡️", text: "Se já clicou em algo suspeito, altere suas senhas e ative o 2FA." });
    
    return recs;
  }
};

