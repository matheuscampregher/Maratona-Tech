  currentIndex: 0,
  score: 0,
  answers: [],

  start() {
    this.currentIndex = 0;
    this.score = 0;
    this.answers = [];
    
    document.getElementById('quizStart').style.display = 'none';
    document.getElementById('quizResult').style.display = 'none';
    document.getElementById('quizGame').style.display = 'block';
    
    this.renderQuestion();
  },

  renderQuestion() {
    const q = this.questions[this.currentIndex];
    const total = this.questions.length;
    
    document.getElementById('quizProgressLabel').textContent = `Questão ${this.currentIndex + 1} de ${total}`;
    document.getElementById('quizScore').textContent = `${this.score} acerto${this.score !== 1 ? 's' : ''}`;
    document.getElementById('quizProgressFill').style.width = `${((this.currentIndex) / total) * 100}%`;
    
    const container = document.getElementById('quizQuestionContainer');
    container.innerHTML = `
      <div class="quiz-question-card">
        <div class="quiz-email-mock">
          <div class="quiz-email-header-mock">
            <div class="quiz-email-field"><span class="label">De:</span><span class="value">${this.escapeHtml(q.from)}</span></div>
            <div class="quiz-email-field"><span class="label">Para:</span><span class="value">${this.escapeHtml(q.to)}</span></div>
            <div class="quiz-email-field"><span class="label">Assunto:</span><span class="value">${this.escapeHtml(q.subject)}</span></div>
          </div>
          <div class="quiz-email-body">${this.escapeHtml(q.body)}</div>
        </div>
        <div class="quiz-answers">
          <button class="quiz-answer-btn" data-choice="safe" onclick="Quiz.answer('safe')">
            🛡️ Seguro
          </button>
          <button class="quiz-answer-btn" data-choice="phishing" onclick="Quiz.answer('phishing')">
            ⚠️ Phishing
          </button>
        </div>
        <div class="quiz-feedback" id="quizFeedback"></div>
      </div>
    `;
  },

  answer(choice) {
    const q = this.questions[this.currentIndex];
    const correct = choice === q.answer;
    if (correct) this.score++;
    
    this.answers.push({ question: this.currentIndex, correct, choice, correctAnswer: q.answer });
    
    // Highlight buttons
    document.querySelectorAll('.quiz-answer-btn').forEach(btn => {
      btn.disabled = true;
      if (btn.dataset.choice === q.answer) btn.classList.add('correct');
      else if (btn.dataset.choice === choice && !correct) btn.classList.add('wrong');
    });
    
    // Show feedback
    const feedback = document.getElementById('quizFeedback');
    feedback.className = `quiz-feedback show ${correct ? 'correct' : 'wrong'}`;
    feedback.innerHTML = `
      <div class="quiz-feedback-title">
        ${correct ? '✓ Resposta correta!' : '✕ Resposta incorreta'}
      </div>
      <p>${q.explanation}</p>
      ${q.signs.length > 0 ? `
        <div class="quiz-signs">
          <strong style="font-size: 0.78rem; color: var(--text-muted);">Sinais presentes:</strong>
          ${q.signs.map(s => `<div class="quiz-sign">⚠ ${s}</div>`).join('')}
        </div>
      ` : ''}
      <button class="btn-primary quiz-next-btn" onclick="Quiz.next()">
        ${this.currentIndex < this.questions.length - 1 ? 'Próxima →' : 'Ver Resultado 🏆'}
      </button>
    `;
    
    if (correct && typeof confetti !== 'undefined') {
      confetti({ particleCount: 30, spread: 60, origin: { y: 0.7 } });
    }
  },

  next() {
    this.currentIndex++;
    if (this.currentIndex < this.questions.length) {
      this.renderQuestion();
    } else {
      this.finish();
    }
  },

  finish() {
    document.getElementById('quizGame').style.display = 'none';
    const resultDiv = document.getElementById('quizResult');
    resultDiv.style.display = 'block';
    
    const total = this.questions.length;
    const pct = Math.round((this.score / total) * 100);
    
    let level, levelDesc;
    if (pct >= 90) { level = '🏆 ESPECIALISTA'; levelDesc = 'Você é um verdadeiro caçador de phishing!'; }
    else if (pct >= 70) { level = '⭐ INTERMEDIÁRIO'; levelDesc = 'Ótimo conhecimento! Continue praticando.'; }
    else if (pct >= 50) { level = '📚 APRENDIZ'; levelDesc = 'Bom começo! Estude mais na aba Aprender.'; }
    else { level = '🔰 INICIANTE'; levelDesc = 'Hora de estudar! Revise os sinais de alerta.'; }
    
    resultDiv.innerHTML = `
      <div class="result-score-circle" style="--pct: ${pct}">
        <div class="result-score-value">${pct}<small>%</small></div>
      </div>
      <div class="result-level">${level}</div>
      <p style="color: var(--text-secondary); font-size: 0.95rem;">${levelDesc}</p>
      
      <div class="result-stats">
        <div class="stat-card">
          <span class="value" style="color: var(--accent-success);">${this.score}</span>
          <span class="label">Acertos</span>
        </div>
        <div class="stat-card">
          <span class="value" style="color: var(--accent-danger);">${total - this.score}</span>
          <span class="label">Erros</span>
        </div>
        <div class="stat-card">
          <span class="value">${total}</span>
          <span class="label">Total</span>
        </div>
      </div>
      
      <button class="btn-primary" onclick="Quiz.restart()" style="margin-top: 1rem;">
        🔄 Jogar Novamente
      </button>
      <button class="btn-secondary" onclick="switchTab('learn')">
        📚 Estudar Mais
      </button>
    `;
    
    // Record stats
    Storage.recordQuiz(this.score, total);
    const stats = Storage.get(Storage.keys.stats, Storage.getDefaultStats());
    stats._lastPerfect = this.score === total;
    Storage.set(Storage.keys.stats, stats);
    
    Dashboard.updateStats();
    Achievements.check(stats);
    
    if (pct >= 80 && typeof confetti !== 'undefined') {
      confetti({ particleCount: 150, spread: 100, origin: { y: 0.5 } });
    }
    
    Toast.show('success', 'Quiz Concluído!', `Você acertou ${this.score}/${total}`);
  },

  restart() {
    document.getElementById('quizResult').style.display = 'none';
    document.getElementById('quizStart').style.display = 'block';
  },

  escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
};

