  selected: null,

  init() {
    const container = document.getElementById('generatorBrands');
    container.innerHTML = this.brands.map(b => `
      <div class="brand-card" data-brand="${b.id}" onclick="Generator.select('${b.id}')">
        <div class="brand-icon">${b.icon}</div>
        <div class="brand-name">${b.name}</div>
      </div>
    `).join('');
  },

  select(brandId) {
    this.selected = brandId;
    document.querySelectorAll('.brand-card').forEach(c => {
      c.classList.toggle('selected', c.dataset.brand === brandId);
    });
  },

  generate() {
    if (!this.selected) {
      Toast.show('warning', 'Aviso', 'Selecione uma marca primeiro.');
      return;
    }

    const template = this.templates[this.selected];
    const brand = this.brands.find(b => b.id === this.selected);
    
    const body = document.getElementById('generatedEmailBody');
    
    // Highlight techniques in text
    let highlighted = this.escape(template.body);
    
    // Highlight suspicious URLs
    highlighted = highlighted.replace(
      /(https?:\/\/[^\s]+|bit\.ly\/[^\s]+)/g,
      '<span class="highlight-phish" title="Link suspeito">$1</span>'
    );
    
    // Highlight sensitive data requests
    highlighted = highlighted.replace(
      /(senha|CPF|token|cart[aã]o|CVV|c[oó]digo|login)/gi,
      '<span class="highlight-phish" title="Dado sensível solicitado">$1</span>'
    );
    
    // Highlight urgency words
    highlighted = highlighted.replace(
      /(AGORA|URGENTE|BLOQUEADA|SUSPENSA|24 horas|12 horas|IMEDIATAMENTE)/g,
      '<span class="highlight-phish" title="Urgência artificial">$1</span>'
    );
    
    body.innerHTML = `
      <div style="margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px dashed var(--border-color);">
        <div><span style="color: var(--text-muted);">De:</span> <span class="highlight-phish" title="Domínio falso">${template.from}</span></div>
        <div><span style="color: var(--text-muted);">Assunto:</span> <span class="highlight-phish" title="Assunto alarmista">${template.subject}</span></div>
      </div>
      ${highlighted}
    `;
    
    // Techniques list
    const techList = document.getElementById('techniquesList');
    techList.innerHTML = template.techniques.map(t => `
      <div class="technique-item">
        <h5>${t.name}</h5>
        <p>${t.desc}</p>
      </div>
    `).join('');
    
    document.getElementById('generatedEmailWrapper').classList.add('show');
    document.getElementById('generatedEmailWrapper').scrollIntoView({ behavior: 'smooth', block: 'start' });
    
    Toast.show('info', 'Exemplo Gerado', `${brand.name}: exemplo educativo criado`);
  },

  escape(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
};

/* ============================================
   DASHBOARD MODULE
   ============================================ */
const Dashboard = {
  chartsInitialized: false,
  charts: {},

  init() {
    this.updateStats();
    Achievements.render();
    this.initCharts();
  },

  updateStats() {
    const stats = Storage.get(Storage.keys.stats, Storage.getDefaultStats());
    
    this.animateNumber('stat-analyses', stats.analyses || 0);
    this.animateNumber('stat-threats', stats.threats || 0);
    this.animateNumber('stat-quizzes', stats.quizzes || 0);
    document.getElementById('stat-avg-score').textContent = (stats.avgScore || 0) + '%';
  },

  animateNumber(id, target) {
    const el = document.getElementById(id);
    if (!el) return;
    const current = parseInt(el.textContent) || 0;
    if (current === target) return;
    
    const steps = 30;
    const increment = (target - current) / steps;
    let value = current;
    let i = 0;
    
    const interval = setInterval(() => {
      i++;
      value += increment;
      if (i >= steps) {
        value = target;
        clearInterval(interval);
      }
      el.textContent = Math.round(value);
    }, 20);
  },

  initCharts() {
    if (typeof Chart === 'undefined') {
      console.warn('Chart.js não carregado');
      return;
    }
    
    const stats = Storage.get(Storage.keys.stats, Storage.getDefaultStats());
    const textColor = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim();
    const gridColor = getComputedStyle(document.documentElement).getPropertyValue('--border-color').trim();
    
    Chart.defaults.color = textColor;
    Chart.defaults.borderColor = gridColor;
    Chart.defaults.font.family = "'Inter', sans-serif";
    
    // Analyses chart
    const ctx1 = document.getElementById('chart-analyses');
    if (ctx1) {
      const days = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
      const today = new Date().getDay();
      const labels = [];
      const data = [];
      const last7 = stats.last7Days || [0,0,0,0,0,0,0];
      
      for (let i = 6; i >= 0; i--) {
        const dayIndex = (today - i + 7) % 7;
        labels.push(days[dayIndex]);
        data.push(last7[dayIndex] || 0);
      }
      
      this.charts.analyses = new Chart(ctx1, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Análises',
            data: data,
            borderColor: '#00d9ff',
            backgroundColor: 'rgba(0, 217, 255, 0.1)',
            tension: 0.4,
            fill: true,
            borderWidth: 2,
            pointBackgroundColor: '#00d9ff',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { stepSize: 1 },
              grid: { color: gridColor }
            },
            x: { grid: { display: false } }
          }
        }
      });
    }
    
    // Threat types chart
    const ctx2 = document.getElementById('chart-threats');
    if (ctx2) {
      const threatTypes = stats.threatTypes || { urgency: 0, links: 0, sensitive: 0, structure: 0 };
      const data = [
        threatTypes.urgency || 0,
        threatTypes.links || 0,
        threatTypes.sensitive || 0,
        threatTypes.structure || 0
      ];
      
      this.charts.threats = new Chart(ctx2, {
        type: 'doughnut',
        data: {
          labels: ['Urgência', 'Links', 'Dados', 'Estrutura'],
          datasets: [{
            data: data,
            backgroundColor: [
              '#ff3366',
              '#ffb800',
              '#00d9ff',
              '#7b2cff'
            ],
            borderColor: '#0a0f1c',
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '60%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: { padding: 15, font: { size: 11 } }
            }
          }
        }
      });
    }
    
    this.chartsInitialized = true;
  },

  updateCharts() {
    if (!this.chartsInitialized) return;
    
    const stats = Storage.get(Storage.keys.stats, Storage.getDefaultStats());
    
    if (this.charts.analyses) {
      const today = new Date().getDay();
      const last7 = stats.last7Days || [0,0,0,0,0,0,0];
      const data = [];
      for (let i = 6; i >= 0; i--) {
        const dayIndex = (today - i + 7) % 7;
        data.push(last7[dayIndex] || 0);
      }
      this.charts.analyses.data.datasets[0].data = data;
      this.charts.analyses.update();
    }
    
    if (this.charts.threats) {
      const threatTypes = stats.threatTypes || { urgency: 0, links: 0, sensitive: 0, structure: 0 };
      this.charts.threats.data.datasets[0].data = [
        threatTypes.urgency || 0,
        threatTypes.links || 0,
        threatTypes.sensitive || 0,
        threatTypes.structure || 0
      ];
      this.charts.threats.update();
    }
  }
};

/* ============================================
   UI MODULE - Tab switching
   ============================================ */
const UI = {
  init() {
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        switchTab(btn.dataset.tab);
      });
    });
  }
};

function switchTab(tabName) {
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === tabName);
  });
  document.querySelectorAll('.tab-content').forEach(c => {
    c.classList.toggle('active', c.id === 'tab-' + tabName);
  });
  
  // Refresh dashboard data when switching to it
  if (tabName === 'dashboard') {
    Dashboard.updateStats();
    Achievements.render();
    Dashboard.updateCharts();
  }
  
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

