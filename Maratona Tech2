<script>
/* ============================================
   STORAGE MODULE - Persistence
   ============================================ */
const Storage = {
  keys: {
    theme: 'sentinel_theme',
    stats: 'sentinel_stats',
    achievements: 'sentinel_achievements',
    quizHistory: 'sentinel_quiz_history',
    analysisHistory: 'sentinel_analysis_history'
  },

  get(key, defaultValue = null) {
    try {
      const value = localStorage.getItem(key);
      return value ? JSON.parse(value) : defaultValue;
    } catch (e) {
      return defaultValue;
    }
  },

  set(key, value) {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch (e) {
      console.warn('Storage error:', e);
    }
  },

  getDefaultStats() {
    return {
      analyses: 0,
      threats: 0,
      quizzes: 0,
      quizCorrect: 0,
      quizTotal: 0,
      avgScore: 0,
      last7Days: [0, 0, 0, 0, 0, 0, 0],
      threatTypes: { urgency: 0, links: 0, sensitive: 0, structure: 0 }
    };
  },

  incrementStat(field, amount = 1) {
    const stats = this.get(this.keys.stats, this.getDefaultStats());
    stats[field] = (stats[field] || 0) + amount;
    this.set(this.keys.stats, stats);
    return stats;
  },

  recordAnalysis(isThreat, threatCategories = []) {
    const stats = this.get(this.keys.stats, this.getDefaultStats());
    stats.analyses = (stats.analyses || 0) + 1;
    if (isThreat) stats.threats = (stats.threats || 0) + 1;
    
    // Update last 7 days
    const today = new Date().getDay();
    if (!Array.isArray(stats.last7Days)) stats.last7Days = [0,0,0,0,0,0,0];
    stats.last7Days[today] = (stats.last7Days[today] || 0) + 1;
    
    // Update threat types
    if (!stats.threatTypes) stats.threatTypes = { urgency: 0, links: 0, sensitive: 0, structure: 0 };
    threatCategories.forEach(cat => {
      if (stats.threatTypes[cat] !== undefined) stats.threatTypes[cat]++;
    });
    
    this.set(this.keys.stats, stats);
    return stats;
  },

  recordQuiz(correct, total) {
    const stats = this.get(this.keys.stats, this.getDefaultStats());
    stats.quizzes = (stats.quizzes || 0) + 1;
    stats.quizCorrect = (stats.quizCorrect || 0) + correct;
    stats.quizTotal = (stats.quizTotal || 0) + total;
    stats.avgScore = Math.round((stats.quizCorrect / stats.quizTotal) * 100);
    this.set(this.keys.stats, stats);
    return stats;
  }
};

